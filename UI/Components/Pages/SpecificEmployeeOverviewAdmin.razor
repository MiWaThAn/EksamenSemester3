@page "/specific-employee-admin/{employeeId:guid}"
@using Shared.Model
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>SpecificEmployeeOverviewAdmin</h3>

<div class="container mt-4 d-flex justify-content-center">
    @if (isLoading)
    {
        <div class="text-white text-center p-4">
            <div class="spinner-border text-light mb-3" role="status"></div>
            <div><strong>Henter Henriks information, big boss...</strong></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (employeeDetail != null)
    {
        <div class="detailed-card-container shadow">

            <div class="detail-header font-weight-bold text-center">
                @employeeDetail.FullName
            </div>

            <div class="detail-info-box shadow-sm mb-4">
                <div class="p-3 text-center border-bottom">
                    Mobil: @employeeDetail.MobileNumber
                </div>
                <div class="p-3 text-center">
                    Email: @employeeDetail.Email
                </div>
            </div>

            <div class="project-list-section">
                <div class="text-center font-weight-bold mb-3">Projekter:</div>

                @if (employeeDetail.Projects != null && employeeDetail.Projects.Any())
                {
                    @foreach (var proj in employeeDetail.Projects)
                    {
                        <div class="p-3 text-center mb-2 project-item-card shadow-sm"
                             @onclick="() => GaaTilProjekt(proj.Id)">
                            @proj.ProjectName
                        </div>
                    }
                }
                else
                {
                    <div class="p-3 text-center empty-projects-card">
                        Der er ikke tilknyttet nogle projekter endnu, legend.
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn action-btn shadow-sm" @onclick="GoBack">Tilbage</button>
                <button class="btn action-btn shadow-sm" @onclick="NavigateToEdit">Rediger</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid employeeId { get; set; }

    private DetailedEmployeeModel? employeeDetail;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {

    }

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSet kører, når ruten ændres, så vi genindlæser data rigtigt!
        await LoadEmployeeData();
    }

    private async Task LoadEmployeeData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Vi kalder jeres API-endpoint via jeres Dev Tunnel.
            // Sørg for at have et endpoint, der f.eks. hedder: api/medarbejder/admin/{id}
            employeeDetail = await Http.GetFromJsonAsync<DetailedEmployeeModel>($"api/medarbejder/admin/{employeeId}");
        }
        catch (Exception ex)
        {
            var actualException = ex.InnerException ?? ex;
            errorMessage = $"Hovsa, der gik noget galt i kælderen: {actualException.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/company-overview-admin"); // Sender dig tilbage til hovedoversigten!
    }

    private void NavigateToEdit()
    {
        // Forberedt til fremtiden, hvis Pschæf vil have en redigerings-skærm!
        Navigation.NavigateTo($"/employee-edit/{employeeId}");
    }

    private void GaaTilProjekt(Guid id)
    {
        // Navigerer direkte videre til den specifikke projektside, hvis man trykker på det!
        Navigation.NavigateTo($"/specific-project-admin/{id}");
    }
}
