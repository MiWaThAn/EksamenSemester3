@page "/specific-project-admin/{projectId:guid}"
@using Shared.Model
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Admin Projekt Detaljer</PageTitle>

<div class="specific-admin-bg">
    @if (isLoading)
    {
        <div class="text-white text-center p-4">
            <div class="spinner-border text-light mb-3" role="status"></div>
            <div><strong>Henter projektets detaljer...</strong></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (projectDetail != null)
    {
        <h1 class="specific-admin-title">@projectDetail.ProjectName</h1>

        <div class="specific-admin-info-box">
            <div class="specific-admin-info-item">
                Status: @(projectDetail.IsSelected ? "Aktivt / Valgt" : "Inaktivt")
            </div>
            <div class="specific-admin-divider"></div>
            <div class="specific-admin-info-item text-muted" style="font-size: 0.9rem;">
                Notifikationer: @projectDetail.NotificationCount
            </div>
        </div>

        <div class="specific-admin-label">Projekt Information:</div>
        <div class="specific-admin-list" style="margin-bottom: 1.5rem;">
            <div class="specific-admin-project-card" style="cursor: default; display: block; padding: 1rem;">
                <p style="margin-bottom: 0.5rem;"><strong>Kunde:</strong> @projectDetail.CustomerName</p>
                <p style="margin: 0; font-size: 0.9rem;" class="text-muted"><strong>Beskrivelse:</strong> @projectDetail.Description</p>
            </div>
        </div>

        <div class="specific-admin-label">Projektets Aktiviteter:</div>
        <div class="specific-admin-list" style="margin-bottom: 1.5rem;">
            @if (projectDetail.Activities != null && projectDetail.Activities.Any())
            {
                @foreach (var akt in projectDetail.Activities)
                {
                    <div class="specific-admin-project-card" style="display: flex; justify-between; items-center; padding: 1rem; cursor: default;">
                        <div style="flex: 1;">
                            <div style="font-size: 0.8rem; font-family: monospace;" class="text-muted">Nr: @akt.ActivityNumber</div>
                            <strong style="font-size: 1.1rem; display: block; margin: 0.2rem 0;">@akt.ActivityName</strong>
                            <span style="font-size: 0.85rem;" class="text-muted">Estimat: @akt.TimeEstimate timer</span>
                        </div>

                        <div>
                            <span class="badge @GetAdminStatusBadgeClass(akt.Status)">
                                @akt.StatusText
                            </span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="specific-admin-empty-card">
                    Ingen aktiviteter oprettet på dette projekt endnu.
                </div>
            }
        </div>

        <div class="specific-admin-label">Tilknyttede medarbejdere:</div>
        <div class="specific-admin-list">
            @if (projectDetail.Employees != null && projectDetail.Employees.Any())
            {
                @foreach (var emp in projectDetail.Employees)
                {
                    <div class="specific-admin-project-card" @onclick="() => GoToEmployee(emp.Id)">
                        @emp.FullName
                    </div>
                }
            }
            else
            {
                <div class="specific-admin-empty-card">
                    Ingen medarbejdere tilkoblet dette projekt endnu.
                </div>
            }
        </div>

        <div class="specific-admin-btn-container">
            <button class="specific-admin-btn" @onclick="GoBack">Tilbage</button>
            <button class="specific-admin-btn" @onclick="NavigateToEdit">Rediger</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid projectId { get; set; }

    private DetailedProjectModel? projectDetail;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProjectData();
    }

    private async Task LoadProjectData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            // Vi kalder nøjagtig samme endpoint som medarbejdersiden – ren genanvendelse!
            projectDetail = await Http.GetFromJsonAsync<DetailedProjectModel>($"api/Project/company/project/{projectId}");
        }
        catch (Exception ex)
        {
            var actualException = ex.InnerException ?? ex;
            errorMessage = $"Kunne ikke hente projektet: {actualException.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/company-overview-admin");
    }

    private void NavigateToEdit()
    {
        Navigation.NavigateTo($"/project-edit/{projectId}");
    }

    private void GoToEmployee(Guid id)
    {
        Navigation.NavigateTo($"/specific-employee-admin/{id}");
    }

    // Bootstrap badge-farver til admin-panelet baseret på aktivitetens status
    private string GetAdminStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "lukket" => "bg-danger text-white",
            "åben" => "bg-success text-white",
            "godkendes" => "bg-warning text-dark",
            _ => "bg-secondary text-white"
        };
    }
}