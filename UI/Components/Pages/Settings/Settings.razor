@page "/settings"
@inject UI.Services.Theme.ThemeService ThemeService
@using Microsoft.AspNetCore.Authorization
@using Shared.Model
@using UI.Services.Integration

@inject IIntegrationService IntegrationService
@attribute [Authorize(Roles ="Company")]

<h3>Udsende Indstillinger</h3>

<div class="mb-3">
    <label for="bgColorPicker" class="form-label">Vælg Baggrunds Farve:</label>
    <input type="color" 
           id="bgColorPicker" 
           class="form-control form-control-color" 
           value="@ThemeService.BackgroundColor" 
           @onchange="HandleColorChange" />
</div>
<h3>Nuværende integrationsindstillinger</h3>
@if (existingSettings == null)
{
    <p>Henter indstillinger...</p>
}
else if (!existingSettings.Any())
{
    <p>Ingen integrationsindstillinger fundet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Udbyder</th>
                <th>Nøgle navn</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var setting in existingSettings)
            {
                <tr>
                    <td>@setting.ProviderName</td>
                    <td>@setting.KeyName</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => HandleDelete(setting.Id)">
                            Slet
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (providers == null)
{
    <p>Henter udbydere...</p>
}
else
{
    <h3>Tilføj ekstern integration</h3>
    <EditForm Model="model" OnValidSubmit="HandleSubmit">
        <InputSelect class="form-select mb-3" @bind-Value="model.ProviderName"
                     @bind-Value:after="OnProviderChanged">
            <option value="">-- Vælg en udbyder --</option>
            @foreach (var provider in providers)
            {
                <option value="@provider.Name">@provider.Name</option>
            }
        </InputSelect>

        @if (availableEntityTypes.Any())
        {
            <div class="mb-3">
                <label class="form-label">Vælg entitetstyper:</label>
                @foreach (var entityType in availableEntityTypes)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input"
                               id="@entityType"
                               checked="@model.SelectedEntityTypes.Contains(entityType)"
                               @onchange="e => ToggleEntityType(entityType, (bool)e.Value!)" />
                        <label class="form-check-label" for="@entityType">@entityType</label>
                    </div>
                }
            </div>
        }
        <p>Nøgle Navn: @model.KeyName</p>

        <input type="text" class="form-control mb-2"
               placeholder="Indtast nøgle"
               @bind="model.KeyValue" />

        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">
            @(isSaving ? "Opretter..." : "Gem")
        </button>
    </EditForm>
}
@if (isSaving)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="background-color: rgba(0,0,0,0.6); z-index: 9999;">

        <div class="card shadow-lg border-0 p-4 text-center"
             style="min-width: 350px;">

            <div class="spinner-border text-primary mb-3"
                 role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <h5>Opretter integration...</h5>

            <p class="text-muted mb-0">
                Vent venligst mens nøglen bliver oprettet.
            </p>

        </div>

    </div>
}
@code {
    private void HandleColorChange(ChangeEventArgs e)
    {
        var selectedColor = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedColor))
            ThemeService.UpdateBackgroundColor(selectedColor);
    }

    private FormModel model = new();
    private List<ProviderModel>? providers;
    private List<IntegrationSettingModel>? existingSettings;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        providers = await IntegrationService.GetProvidersAsync();
        existingSettings = await IntegrationService.GetMyIntegrationSettingsAsync();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSaving = true;

            await IntegrationService.CreateIntegrationSettingAsync(
                model.ProviderName,
                model.KeyName,
                model.KeyValue,
                model.SelectedEntityTypes);

            existingSettings = await IntegrationService.GetMyIntegrationSettingsAsync();
            model = new();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleDelete(Guid settingId)
    {
        await IntegrationService.DeleteIntegrationSettingAsync(settingId);
        existingSettings = await IntegrationService.GetMyIntegrationSettingsAsync();
    }

    private class FormModel
    {
        public string ProviderName { get; set; } = string.Empty;
        public string KeyName { get; set; } = string.Empty;
        public string KeyValue { get; set; } = string.Empty;
        public List<string> SelectedEntityTypes { get; set; } = new();
    }
    private List<string> availableEntityTypes = new();



    private void OnProviderChanged()
    {
        // TODO: Make it so providers have keynames attached to their class so we easily can pick the right one 
        model.KeyName = "X-AgreementGrantToken";
        var selected = providers?.FirstOrDefault(p => p.Name == model.ProviderName);
        availableEntityTypes = selected?.SupportedEntityTypes ?? new();
        model.SelectedEntityTypes.Clear();
    }

    private void ToggleEntityType(string entityType, bool isChecked)
    {
        if (isChecked && !model.SelectedEntityTypes.Contains(entityType))
            model.SelectedEntityTypes.Add(entityType);
        else if (!isChecked)
            model.SelectedEntityTypes.Remove(entityType);
    }



}

   




