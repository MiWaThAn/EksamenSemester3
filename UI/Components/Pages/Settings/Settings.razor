@page "/settings"
@inject UI.Services.Theme.ThemeService ThemeService
@using Microsoft.AspNetCore.Authorization
@using Shared.Model
@using UI.Services.Integration

@inject IIntegrationService IntegrationService
@attribute [Authorize(Roles ="Company")]

<div class="container py-4">

    <div class="row g-4">

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-3">

                        <div class="bg-primary bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;">

                            <span class="fs-4">🎨</span>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-1">
                                Udseende
                            </h4>

                            <p class="text-muted mb-0">
                                Tilpas systemets visuelle tema.
                            </p>

                        </div>

                    </div>

                    <div class="row align-items-center">

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Baggrundsfarve
                            </label>

                            <input type="color"
                                   id="bgColorPicker"
                                   class="form-control form-control-color"
                                   value="@ThemeService.BackgroundColor"
                                   @onchange="HandleColorChange" />

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Existing Integrations -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h4 class="fw-bold mb-1">
                                Aktive Integrationer
                            </h4>

                            <p class="text-muted mb-0">
                                Administrer eksisterende integrationer.
                            </p>

                        </div>

                    </div>

                    @if (existingSettings == null)
                    {
                        <div class="text-center py-5">

                            <div class="spinner-border text-primary"></div>

                            <div class="mt-3 text-muted">
                                Henter integrationer...
                            </div>

                        </div>
                    }
                    else if (!existingSettings.Any())
                    {
                        <div class="alert alert-light border mb-0">

                            Ingen integrationsindstillinger fundet.

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead>

                                    <tr>
                                        <th>Udbyder</th>
                                        <th>Nøgle Navn</th>
                                        <th class="text-end">Handlinger</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var setting in existingSettings)
                                    {
                                        <tr>

                                            <td>

                                                <div class="fw-semibold">
                                                    @setting.ProviderName
                                                </div>

                                            </td>

                                            <td>

                                                <code>
                                                    @setting.KeyName
                                                </code>

                                            </td>

                                            <td>

                                                <div class="d-flex justify-content-end gap-2">

                                                    <button class="btn btn-outline-primary btn-sm"
                                                            @onclick="() => HandleSync(setting.Id)">

                                                        🔄 Synkroniser

                                                    </button>

                                                    <button class="btn btn-outline-danger btn-sm"
                                                            @onclick="() => HandleDelete(setting.Id)">

                                                        🗑 Slet

                                                    </button>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="bg-success bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;">

                            <span class="fs-4">🔌</span>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-1">
                                Tilføj Integration
                            </h4>

                            <p class="text-muted mb-0">
                                Opret forbindelse til et eksternt system.
                            </p>

                        </div>

                    </div>

                    @if (providers == null)
                    {
                        <div class="text-center py-4">

                            <div class="spinner-border text-primary"></div>

                        </div>
                    }
                    else
                    {
                        <EditForm Model="model"
                                  OnValidSubmit="HandleSubmit">

                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    Udbyder
                                </label>

                                <InputSelect class="form-select"
                                             @bind-Value="model.ProviderName"
                                             @bind-Value:after="OnProviderChanged">

                                    <option value="">
                                        -- Vælg udbyder --
                                    </option>

                                    @foreach (var provider in providers)
                                    {
                                        <option value="@provider.Name">
                                            @provider.Name
                                        </option>
                                    }

                                </InputSelect>

                            </div>

                            @if (availableEntityTypes.Any())
                            {
                                <div class="mb-4">

                                    <label class="form-label fw-semibold">
                                        Entitetstyper
                                    </label>

                                    <div class="row g-2">

                                        @foreach (var entityType in availableEntityTypes)
                                        {
                                            <div>

                                                <div class="form-check border rounded p-3">

                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           id="@entityType"
                                                           checked="@model.SelectedEntityTypes.Contains(entityType)"
                                                           @onchange="e => ToggleEntityType(entityType, (bool)e.Value!)" />

                                                    <label class="form-check-label ms-1"
                                                           for="@entityType">

                                                        @entityType

                                                    </label>

                                                </div>

                                            </div>
                                        }

                                    </div>

                                </div>
                            }

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Nøglenavn
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@model.KeyName"
                                       readonly />

                            </div>

                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    API Nøgle
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Indsæt nøgle..."
                                       @bind="model.KeyValue" />

                            </div>

                            <button type="submit"
                                    class="btn btn-primary px-4"
                                    disabled="@isSaving">

                                @(isSaving ? "Opretter..." : "Gem Integration")

                            </button>

                        </EditForm>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
@if (isSaving)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg">

                <div class="modal-body text-center p-5">

                    <div class="spinner-border text-primary mb-3"
                         role="status">
                    </div>

                    <h5 class="fw-bold">
                        Opretter integration...
                    </h5>

                    <p class="text-muted mb-0">
                        Vent venligst mens nøglen bliver oprettet.
                    </p>

                </div>

            </div>

        </div>

    </div>
}
@if (isSyncing)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg">

                <div class="modal-body text-center p-5">

                    <div class="spinner-border text-primary mb-3"
                         role="status">
                    </div>

                    <h5 class="fw-bold">
                        Synkronisere din integration...
                    </h5>

                    <p class="text-muted mb-0">
                        Vent venligst mens din data bliver hentet.
                    </p>

                </div>

            </div>

        </div>

    </div>
}

@code {
    private void HandleColorChange(ChangeEventArgs e)
    {
        var selectedColor = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedColor))
            ThemeService.UpdateBackgroundColor(selectedColor);
    }

    private FormModel model = new();
    private List<ProviderModel>? providers;
    private List<IntegrationSettingModel>? existingSettings;
    private bool isSaving;
    private bool isSyncing;

    protected override async Task OnInitializedAsync()
    {
        providers = await IntegrationService.GetProvidersAsync();
        existingSettings = await IntegrationService.GetMyIntegrationSettingsAsync();
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSaving = true;

            await IntegrationService.CreateIntegrationSettingAsync(
                model.ProviderName,
                model.KeyName,
                model.KeyValue,
                model.SelectedEntityTypes);

            existingSettings = await IntegrationService.GetMyIntegrationSettingsAsync();
            model = new();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleDelete(Guid settingId)
    {
        await IntegrationService.DeleteIntegrationSettingAsync(settingId);
        existingSettings = await IntegrationService.GetMyIntegrationSettingsAsync();
    }

    private async Task HandleSync(Guid settingId)
    {
        try
        {
            isSyncing = true;
            await IntegrationService.TriggerSyncAsync(settingId);
        }
        finally
        {
            isSyncing = false;
        }
    }

    private class FormModel
    {
        public string ProviderName { get; set; } = string.Empty;
        public string KeyName { get; set; } = string.Empty;
        public string KeyValue { get; set; } = string.Empty;
        public List<string> SelectedEntityTypes { get; set; } = new();
    }
    private List<string> availableEntityTypes = new();



    private void OnProviderChanged()
    {
        // TODO: Make it so providers have keynames attached to their class so we easily can pick the right one 
        model.KeyName = "X-AgreementGrantToken";
        var selected = providers?.FirstOrDefault(p => p.Name == model.ProviderName);
        availableEntityTypes = selected?.SupportedEntityTypes ?? new();
        model.SelectedEntityTypes.Clear();
    }

    private void ToggleEntityType(string entityType, bool isChecked)
    {
        if (isChecked && !model.SelectedEntityTypes.Contains(entityType))
            model.SelectedEntityTypes.Add(entityType);
        else if (!isChecked)
            model.SelectedEntityTypes.Remove(entityType);
    }



}

   




