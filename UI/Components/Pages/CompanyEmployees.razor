@page "/company-employees"
@using Shared.Model;
@inject HttpClient Http

<div class="admin-container">
    <div class="tab-header">
        <div class="tab-item @(activeTab == "employees" ? "active" : "")"
             @onclick='() => activeTab = "employees"'>
            Medarbejdere
        </div>
             
        <div class="tab-item @(activeTab == "projects" ? "active" : "")"
             @onclick='() => activeTab = "projects"'>
            Projekter
        </div>
    </div>

    <div class="list-wrapper shadow-box">
        @if (activeTab == "employees")
        {
            @if (employees == null)
            {
                <p>Henter medarbejdere...</p>
            }
            else
            {
                @foreach (var emp in employees)
                {
                    <div class="employee-row @(emp.NotificationCount > 0 ? "selected" : "")">
                        <span>@emp.FullName</span>
                        <div class="mail-container">
                            <i class="bi bi-envelope-fill"></i>
                            @if (emp.NotificationCount > 0)
                            {
                                <span class="mail-badge">@emp.NotificationCount</span>
                            }
                        </div>
                    </div>
                }
            }
        }
        else
        {
            // foreach projekt vis data... ligesom med employees // TODO
            <p style="padding: 20px;">Henter projekter...</p>
        }
    </div>

    <button class="btn-new-registration shadow-box">Ny Registrering</button>
</div>

@code {
    private string activeTab = "employees";
    private List<CompanyEmployeeModel>? employees;
    private string testCompanyId = "1F38968B-1A7E-443E-BD2D-1C1066EB821E";

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeeData();
    }

    private async Task LoadEmployeeData()
    {
        try
        {
            employees = await Http.GetFromJsonAsync<List<CompanyEmployeeModel>>($"api/employee/company/{testCompanyId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fejl ved hentning: {ex.Message}");
        }
    }

    private async Task SwitchTab(string tabName)
    {
        activeTab = tabName;

        if (activeTab == "employees")
        {
            await LoadEmployeeData();
        }
        else if (activeTab == "projects")
        {
            // Project api call here later // TODO
            employees = null;
        }
    }
}