@page "/time-registration"
@inject IJSRuntime JS


<h2 class="text-center mb-4">Stop-Ur</h2>

<div class="text-center mb-4" style="font-size:2rem; margin-bottom:1rem;">
	<span id="display">00:00:00.0</span>
</div>

<div class="d-flex justify-content-center gap-2">
@if (!_isRunning)
{
	<button class="btn btn-success btn-lg" @onclick="Start">Start</button>
}
@if (_isRunning)
{
	<button class="btn btn-success btn-lg" @onclick="Stop">Pause</button>
}
<button class="btn btn-danger btn-lg" @onclick="Reset">Nulstil</button>
</div>

@code {
	private IJSObjectReference? _module;
	private bool _isRunning = false;

	protected override async Task OnAfterRenderAsync (bool firstrender)
	{
		if (firstrender)
		{
			_module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/stopwatch.js");
			await _module.InvokeVoidAsync("initializeStopwatch");
		}
	}
	private async Task Start()
	{
		await _module!.InvokeVoidAsync("startStopwatch");
		_isRunning = true;
	}
	private async Task Stop()
	{
		await _module!.InvokeVoidAsync("stopStopwatch");
		_isRunning = false;
	}
	private async Task Reset()
	{
		await _module!.InvokeVoidAsync("resetStopwatch");
		_isRunning = false;
	}
}



<div class="d-flex justify-content-center gap-2 mt-4">
	<button class="btn btn-primary btn-lg" type="button">Registrer tid</button>
	<button class="btn btn-secondary btn-lg" type="button">Manuelt indtast tid</button>
</div>