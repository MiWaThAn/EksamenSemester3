@page "/register-company"
@using Services.Auth
@using Shared.Person.Auth.Models.Registration
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="container">
    <h3>Registrer Virksomhed</h3>

    <EditForm Model="@model" OnValidSubmit="HandleRegistration">
        <DataAnnotationsValidator />
        
        <div class="form-group">
            <label>Virksomhedsnavn</label>
            <InputText @bind-Value="model.CompanyName" class="form-control" />
            <ValidationMessage For="@(() => model.CompanyName)" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <InputText @bind-Value="model.Password" type="password" class="form-control" />
            <ValidationMessage For="@(() => model.Password)" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
            @if (isSubmitting) { <span class="spinner-border spinner-border-sm"></span> }
            Registrer
        </button>
    </EditForm>
</div>

@code {
    private RegisterCompanyModel model = new();
    private string errorMessage;
    private bool isSubmitting;

    private async Task HandleRegistration()
    {
        isSubmitting = true;
        errorMessage = null;

        var result = await AuthService.RegisterCompany(model);

        if (result.Success)
            Nav.NavigateTo("/login");
        else
            errorMessage = result.Message;

        isSubmitting = false;
    }
}