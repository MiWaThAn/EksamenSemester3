@page "/auth/reset-password"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container max-w-md mx-auto p-6 flex flex-col justify-center min-h-screen">
    <div class="bg-white p-8 rounded-xl shadow-md border border-gray-100">

        <div class="text-center mb-8">
            <h3 class="text-3xl font-bold text-gray-800">Vælg nyt kodeord</h3>
            <p class="text-gray-500 text-sm mt-2">Skriv dit nye stærke kodeord herunder, legend</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm" role="alert">
                <span>@_errorMessage</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 text-sm" role="alert">
                <span>@_successMessage</span>
            </div>
        }

        @if (!_isCompleted)
        {
            <div class="mb-4">
                <label class="block font-semibold mb-1 text-gray-700">Nyt kodeord</label>
                <input type="password" class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-500 text-gray-800 focus:outline-none transition"
                       placeholder="••••••••" @bind="_newPassword" />
            </div>

            <div class="mb-6">
                <label class="block font-semibold mb-1 text-gray-700">Gentag kodeord</label>
                <input type="password" class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-500 text-gray-800 focus:outline-none transition"
                       placeholder="••••••••" @bind="_confirmPassword" />
            </div>

            <button @onclick="HandleResetAsync" disabled="@_isBusy" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded transition duration-200">
                @(_isBusy ? "Opdaterer..." : "Opdater kodeord")
            </button>
        }
        else
        {
            <button @onclick="NavigateToLogin" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded transition duration-200">
                Gå til login
            </button>
        }

    </div>
</div>

@code {
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isBusy = false;
    private bool _isCompleted = false;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task HandleResetAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 4)
        {
            _errorMessage = "Kodeordet skal være på mindst 4 tegn, big boss.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "Adgangskoderne matcher ikke hinanden.";
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            // Vi trækker token ud fra URL'en helt organisk via NavigationManager
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var tokenValue);
            string token = tokenValue.ToString();

            if (string.IsNullOrWhiteSpace(token))
            {
                _errorMessage = "Nulstillings-token mangler eller er ugyldig. Prøv at bestille et nyt link.";
                _isBusy = false;
                return;
            }

            var requestBody = new { Token = token, NewPassword = _newPassword };
            var response = await Http.PostAsJsonAsync("api/account/reset-password", requestBody);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Dit kodeord er blevet opdateret i databasen! Du kan logge ind nu, big boss!";
                _isCompleted = true;
            }
            else
            {
                _errorMessage = "Kunne ikke nulstille adgangskoden. Token kan være udløbet (30 min).";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Der skete en fejl under lagring af nyt kodeord.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/auth/login");
    }
}