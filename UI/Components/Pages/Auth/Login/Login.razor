@page "/auth/login"
@using Shared.Person.Auth.Models.Login
@using Shared.Model
@using UI.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-12 col-md-8 col-lg-5">

                <div class="text-center mb-4">

                    <h1 class="fw-bold mb-2">
                        FAST
                    </h1>

                    <p class="text-muted mb-0">
                        Tidsregistrering gjort enkelt
                    </p>

                </div>

                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                    <div class="card-body p-4 p-lg-5">

                        @if (!_showForgotPassword)
                        {
                            <div class="text-center mb-4">

                                <h3 class="fw-bold">
                                    Log ind
                                </h3>

                                <p class="text-muted mb-0">
                                    Indtast dine loginoplysninger
                                </p>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(_errorMessage))
                            {
                                <div class="alert alert-danger">

                                    <i class="bi bi-exclamation-triangle me-2"></i>

                                    @_errorMessage

                                </div>
                            }

                            <EditForm Model="@_loginModel"
                                      OnValidSubmit="HandleLoginAsync">

                                <DataAnnotationsValidator />

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Brugernavn
                                    </label>

                                    <InputText class="form-control form-control-lg"
                                               autocomplete="username"
                                               placeholder="Indtast brugernavn"
                                               @bind-Value="_loginModel.Username" />

                                    <ValidationMessage For="@(() => _loginModel.Username)" />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Adgangskode
                                    </label>

                                    <InputText type="password"
                                               class="form-control form-control-lg"
                                               autocomplete="current-password"
                                               placeholder="••••••••"
                                               @bind-Value="_loginModel.Password" />

                                    <ValidationMessage For="@(() => _loginModel.Password)" />

                                </div>

                                <div class="text-end mb-4">

                                    <button type="button"
                                            class="btn btn-link p-0 text-decoration-none"
                                            @onclick="PrepareForgotPassword">

                                        Glemt adgangskode?

                                    </button>

                                </div>

                                @if (_isBusy)
                                {
                                    <button class="btn btn-primary btn-lg w-100"
                                            disabled>

                                        <span class="spinner-border spinner-border-sm me-2"></span>

                                        Logger ind...

                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-primary btn-lg w-100">

                                        Log ind

                                    </button>
                                }

                            </EditForm>
                        }

                        @if (_showForgotPassword && !_isEmailSent)
                        {
                            <div class="text-center mb-4">

                                <div class="mb-3">

                                    <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                        Trin 1 af 2
                                    </span>

                                </div>

                                <h3 class="fw-bold">
                                    Nulstil kodeord
                                </h3>

                                <p class="text-muted">
                                    Indtast din e-mailadresse
                                </p>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(_errorMessage))
                            {
                                <div class="alert alert-danger">

                                    @_errorMessage

                                </div>
                            }

                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    E-mail
                                </label>

                                <input type="email"
                                       class="form-control form-control-lg"
                                       placeholder="navn@firma.dk"
                                       @bind="_forgotPasswordEmail" />

                            </div>

                            <div class="d-grid gap-2">

                                @if (_isBusy)
                                {
                                    <button class="btn btn-primary btn-lg"
                                            disabled>

                                        <span class="spinner-border spinner-border-sm me-2"></span>

                                        Sender...

                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-lg"
                                            @onclick="HandleForgotPasswordAsync">

                                        Send Token

                                    </button>
                                }

                                <button class="btn btn-outline-secondary"
                                        @onclick="ResetToLogin">

                                    Tilbage

                                </button>

                            </div>
                        }

                        @if (_showForgotPassword && _isEmailSent)
                        {
                            <div class="text-center mb-4">

                                <div class="mb-3">

                                    <span class="badge bg-success-subtle text-success px-3 py-2">
                                        Trin 2 af 2
                                    </span>

                                </div>

                                <h3 class="fw-bold">
                                    Indtast Token
                                </h3>

                                <p class="text-muted">
                                    Angiv token og nyt kodeord
                                </p>

                            </div>

                            <div class="alert alert-success">

                                Hvis e-mailen findes i systemet, er der sendt en token.

                            </div>

                            @if (!string.IsNullOrWhiteSpace(_errorMessage))
                            {
                                <div class="alert alert-danger">

                                    @_errorMessage

                                </div>
                            }

                            <EditForm Model="@_resetPasswordModel"
                                      OnValidSubmit="HandleResetPasswordAsync">

                                <DataAnnotationsValidator />

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Token
                                    </label>

                                    <InputText class="form-control form-control-lg"
                                               placeholder="Indsæt token"
                                               @bind-Value="_resetPasswordModel.Token" />

                                </div>

                                <div class="mb-4">

                                    <label class="form-label fw-semibold">
                                        Nyt kodeord
                                    </label>

                                    <InputText type="password"
                                               class="form-control form-control-lg"
                                               placeholder="••••••••"
                                               @bind-Value="_resetPasswordModel.NewPassword" />

                                </div>

                                <div class="d-grid gap-2">

                                    <button type="submit"
                                            class="btn btn-success btn-lg">

                                        Opdater kodeord

                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="ResetToLogin">

                                        Tilbage til login

                                    </button>

                                </div>

                            </EditForm>
                        }

                    </div>

                    <div class="card-footer bg-light border-0 text-center py-3">

                        <small class="text-muted">
                            Oplever du problemer? Kontakt din administrator.
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@code {
    private LoginModel _loginModel = new();
    private ResetPasswordModel _resetPasswordModel = new();

    private bool _isBusy = false;
    private string? _errorMessage;

    private bool _showForgotPassword = false;
    private bool _isEmailSent = false;
    private string _forgotPasswordEmail = string.Empty;

    private void PrepareForgotPassword()
    {
        _showForgotPassword = true;
        _isEmailSent = false;
        _errorMessage = null;
    }

    private void ResetToLogin()
    {
        _showForgotPassword = false;
        _isEmailSent = false;
        _errorMessage = null;
        _forgotPasswordEmail = string.Empty;
        _resetPasswordModel = new ResetPasswordModel();
    }

    private async Task HandleLoginAsync()
    {
        _isBusy = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.Login(_loginModel);

            if (response.Success)
            {
                var state = await AuthService.GetRequiredLoginState();

                if (state == AuthStateStatus.NeedsPinLogin)
                {
                    Navigation.NavigateTo("/auth/pin-login");
                }
                else if (response.Token != null && !string.IsNullOrWhiteSpace(response.Token))
                {
                    var accountId = AuthService.GetUserId(response.Token);
                    if (!AuthService.UserHasPin(response.Token) && !string.IsNullOrWhiteSpace(accountId))
                    {
                        Navigation.NavigateTo($"/auth/register-pin?accountId={accountId}");
                    }
                    Navigation.NavigateTo("/dashboard");
                }
                else
                {
                    Navigation.NavigateTo("/dashboard");
                }
            }
            else
            {
                _errorMessage = response.Message;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Der skete en uventet fejl under forsøget på at logge ind.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleForgotPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_forgotPasswordEmail) || !_forgotPasswordEmail.Contains("@"))
        {
            _errorMessage = "Indtast venligst en gyldig e-mail adresse.";
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/account/forgot-password", new { Email = _forgotPasswordEmail });
            _isEmailSent = true;
            _resetPasswordModel.Email = _forgotPasswordEmail;
        }
        catch (Exception)
        {
            _errorMessage = "Kunne ikke oprette forbindelse til serveren.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleResetPasswordAsync()
    {
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/account/reset-password", _resetPasswordModel);

            if (response.IsSuccessStatusCode)
            {
                ResetToLogin();
                _errorMessage = "Dit kodeord blev opdateret! Du kan nu logge ind";
            }
            else
            {
                _errorMessage = "Ugyldig eller forældet token. Prøv igen";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Kunne ikke forbinde til serveren.";
        }
    }
}