@page "/auth/login"
@using Shared.Person.Auth.Models.Login
@using Shared.Model
@using UI.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="container max-w-md mx-auto p-6 flex flex-col justify-center min-h-screen">
    <div class="bg-white p-8 rounded-xl shadow-md border border-gray-100">

        @if (!_showForgotPassword)
        {
            <div class="text-center mb-8">
                <h3 class="text-3xl font-bold text-gray-800">Log ind</h3>
                <p class="text-gray-500 text-sm mt-2">Indtast dit brugernavn og din adgangskode</p>
            </div>

            <EditForm Model="@_loginModel" OnValidSubmit="HandleLoginAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm" role="alert">
                        <span>@_errorMessage</span>
                    </div>
                }

                <div class="mb-4">
                    <label class="block font-semibold mb-1 text-gray-700" for="username">Brugernavn</label>
                    <InputText id="username" autocomplete="username"
                               class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
                               placeholder="Indtast brugernavn"
                               @bind-Value="_loginModel.Username" />
                    <div class="text-red-500 text-xs mt-1 font-semibold">
                        <ValidationMessage For="@(() => _loginModel.Username)" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block font-semibold mb-1 text-gray-700" for="password">Adgangskode</label>
                    <InputText id="password" type="password" autocomplete="current-password"
                               class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
                               placeholder="••••••••"
                               @bind-Value="_loginModel.Password" />
                    <div class="text-red-500 text-xs mt-1 font-semibold">
                        <ValidationMessage For="@(() => _loginModel.Password)" />
                    </div>
                </div>

                <div class="text-right mb-6">
                    <button type="button" @onclick="PrepareForgotPassword" class="text-sm text-blue-600 hover:underline font-semibold">
                        Glemt adgangskode?
                    </button>
                </div>

                <div class="mt-6">
                    @if (_isBusy)
                    {
                        <button class="w-full bg-blue-400 text-white font-bold py-3 px-4 rounded cursor-not-allowed flex justify-center items-center" disabled>
                            <span class="animate-spin inline-block w-5 h-5 border-2 border-white border-t-transparent rounded-full mr-2"></span>
                            Logger ind...
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded transition duration-200 shadow shadow-blue-200">
                            Log ind
                        </button>
                    }
                </div>
            </EditForm>
        }
        @if (_showForgotPassword && !_isEmailSent)
        {
            <div class="text-center mb-8">
                <h3 class="text-3xl font-bold text-gray-800">Nulstil kodeord</h3>
                <p class="text-gray-500 text-sm mt-2">Indtast din e-mail, så sender vi dig en sikkerhedstoken</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm" role="alert">
                    <span>@_errorMessage</span>
                </div>
            }

            <div class="mb-6">
                <label class="block font-semibold mb-1 text-gray-700">E-mail adresse</label>
                <input type="email" class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
                       placeholder="placeholder@virksomhed.dk" @bind="_forgotPasswordEmail" />
            </div>

            <div class="flex flex-col gap-3">
                @if (_isBusy)
                {
                    <button class="w-full bg-blue-400 text-white font-bold py-3 px-4 rounded cursor-not-allowed text-center" disabled>
                        Sender anmodning...
                    </button>
                }
                else
                {
                    <button @onclick="HandleForgotPasswordAsync" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded transition duration-200">
                        Anmod om token
                    </button>
                }
                <button @onclick="ResetToLogin" class="text-sm text-gray-500 hover:underline text-center mt-2">
                    Tilbage til login
                </button>
            </div>
        }
        @if (_showForgotPassword && _isEmailSent)
        {
            <div class="text-center mb-8">
                <h3 class="text-3xl font-bold text-gray-800">Indtast Token</h3>
                <p class="text-sm mt-2 text-green-600 font-semibold bg-green-50 p-3 rounded border border-green-200">
                    Hvis du indsatte en valid email, vil du modtage en e-mail med en token om et øjeblik.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm" role="alert">
                    <span>@_errorMessage</span>
                </div>
            }

            <EditForm Model="@_resetPasswordModel" OnValidSubmit="HandleResetPasswordAsync">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="block font-semibold mb-1 text-gray-700">Sikkerhedstoken fra mail:</label>
                    <InputText @bind-Value="_resetPasswordModel.Token" class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-500 focus:outline-none transition" placeholder="Indsæt token her..." />
                </div>

                <div class="mb-4">
                    <label class="block font-semibold mb-1 text-gray-700">Nyt Kodeord:</label>
                    <InputText @bind-Value="_resetPasswordModel.NewPassword" type="password" class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-500 focus:outline-none transition" placeholder="••••••••" />
                </div>

                <div class="flex flex-col gap-3 mt-6">
                    <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded transition duration-200">
                        Opdater kodeord
                    </button>
                    <button type="button" @onclick="ResetToLogin" class="text-sm text-gray-500 hover:underline text-center mt-2">
                        Annuller og gå til login
                    </button>
                </div>
            </EditForm>
        }

        <div class="text-center mt-6">
            <p class="text-xs text-gray-400">
                Oplever du problemer? Kontakt venligst din administrator.
            </p>
        </div>

    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private ResetPasswordModel _resetPasswordModel = new();

    private bool _isBusy = false;
    private string? _errorMessage;

    private bool _showForgotPassword = false;
    private bool _isEmailSent = false;
    private string _forgotPasswordEmail = string.Empty;

    private void PrepareForgotPassword()
    {
        _showForgotPassword = true;
        _isEmailSent = false;
        _errorMessage = null;
    }

    private void ResetToLogin()
    {
        _showForgotPassword = false;
        _isEmailSent = false;
        _errorMessage = null;
        _forgotPasswordEmail = string.Empty;
        _resetPasswordModel = new ResetPasswordModel();
    }

    private async Task HandleLoginAsync()
    {
        _isBusy = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.Login(_loginModel);

            if (response.Success)
            {
                var state = await AuthService.GetRequiredLoginState();

                if (state == AuthStateStatus.NeedsPinLogin)
                {
                    Navigation.NavigateTo("/auth/pin-login");
                }
                else if (response.Token != null && !string.IsNullOrWhiteSpace(response.Token))
                {
                    var accountId = AuthService.GetUserId(response.Token);
                    if (!AuthService.UserHasPin(response.Token) && !string.IsNullOrWhiteSpace(accountId))
                    {
                        Navigation.NavigateTo($"/auth/register-pin?accountId={accountId}");
                    }
                    Navigation.NavigateTo("/dashboard");
                }
                else
                {
                    Navigation.NavigateTo("/dashboard");
                }
            }
            else
            {
                _errorMessage = response.Message;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Der skete en uventet fejl under forsøget på at logge ind.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleForgotPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_forgotPasswordEmail) || !_forgotPasswordEmail.Contains("@"))
        {
            _errorMessage = "Indtast venligst en gyldig e-mail adresse.";
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/account/forgot-password", new { Email = _forgotPasswordEmail });
            _isEmailSent = true;
            _resetPasswordModel.Email = _forgotPasswordEmail;
        }
        catch (Exception)
        {
            _errorMessage = "Kunne ikke oprette forbindelse til serveren.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleResetPasswordAsync()
    {
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/account/reset-password", _resetPasswordModel);

            if (response.IsSuccessStatusCode)
            {
                ResetToLogin();
                _errorMessage = "Dit kodeord blev opdateret! Du kan nu logge ind";
            }
            else
            {
                _errorMessage = "Ugyldig eller forældet token. Prøv igen";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Kunne ikke forbinde til serveren.";
        }
    }
}