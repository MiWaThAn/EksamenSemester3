@page "/company-employees"
@using Shared.Model;
@using UI.Services.Auth;
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IAuthService AuthService

<div class="admin-container">
    <div class="tab-header">
        <div class="tab-item @(activeTab == "employees" ? "active" : "")"
             @onclick='() => SwitchTab("employees")'>
            Medarbejdere
        </div>

        <div class="tab-item @(activeTab == "projects" ? "active" : "")"
             @onclick='() => SwitchTab("projects")'>
            Projekter
        </div>
    </div>

    <div class="list-wrapper shadow-box">
        @if (!string.IsNullOrWhiteSpace(errorString))
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm" role="alert">
                <span>@errorString</span>
            </div>
        }

        @if (activeTab == "employees")
        {
            @if (employees == null && string.IsNullOrWhiteSpace(errorString))
            {
                <p style="padding: 20px;">Henter medarbejdere...</p>
            }
            else if (employees != null && !employees.Any())
            {
                <p style="padding: 20px;">Ingen medarbejdere fundet.</p>
            }
            else if (employees != null)
            {
                @foreach (var emp in employees)
                {
                    <div class="employee-row @(emp.NotificationCount > 0 ? "selected" : "")"
                         @onclick="() => NavigateToEmployeeDetails(emp.Id)">
                        <span>@emp.FullName</span>
                        <div class="mail-container">
                            <i class="bi bi-envelope-fill"></i>
                            @if (emp.NotificationCount > 0)
                            {
                                <span class="mail-badge">@emp.NotificationCount</span>
                            }
                        </div>
                    </div>
                }
            }
        }
        else
        {
            @if (projects == null && string.IsNullOrWhiteSpace(errorString))
            {
                <p style="padding: 20px;">Henter projekter...</p>
            }
            else if (projects != null && !projects.Any())
            {
                <p style="padding: 20px;">Ingen projekter fundet.</p>
            }
            else if (projects != null)
            {
                @foreach (var proj in projects)
                {
                    <div class="employee-row @(proj.NotificationCount > 0 ? "selected" : "")"
                         @onclick="() => NavigateToProjectDetails(proj.Id)">
                        <span>@proj.ProjectName</span>
                        <div class="mail-container">
                            <i class="bi bi-envelope-fill"></i>
                            @if (proj.NotificationCount > 0)
                            {
                                <span class="mail-badge">@proj.NotificationCount</span>
                            }
                        </div>
                    </div>
                }
            }
        }
    </div>

    <button class="btn-new-registration shadow-box">Ny Registrering</button>
</div>

@code {
    private string activeTab = "employees";
    private List<CompanyEmployeeModel>? employees;
    private List<CompanyProjectModel>? projects;
    private string? errorString;

    private string? loggedInUserId;
    private string? dynamicCompanyId;
    [Inject] private JwtAuthStateProvider AuthStateProvider { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            errorString = null;

            var token = await SecureStorage.GetAsync("auth_token");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorString = "Ingen aktiv session fundet. Prøv at logge ind igen.";
                return;
            }

            var claims = AuthStateProvider.ParseClaimsFromJwt(token);

            bool isSystemAdmin = claims.Any(c => c.Type == "permission" && c.Value.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                                 || claims.Any(c => c.Type == "role" && c.Value.Equals("Admin", StringComparison.OrdinalIgnoreCase));

            var employeeIdClaim = claims.FirstOrDefault(c => c.Type == "employee_id")?.Value;
            bool isEmployee = !string.IsNullOrWhiteSpace(employeeIdClaim) && Guid.TryParse(employeeIdClaim, out _);

            if (!isSystemAdmin && isEmployee)
            {
                errorString = "Adgang nægtet: Denne sektion er forbeholdt virksomhedens ejer eller en administrator.";
                return;
            }

            loggedInUserId = AuthService.GetUserId(token);

            if (string.IsNullOrEmpty(loggedInUserId))
            {
                errorString = "Kunne ikke finde dit bruger-ID i sessionen.";
                return;
            }

            var response = await Http.GetFromJsonAsync<CompanyResponse>($"api/account/company-id/{loggedInUserId}");

            if (response != null)
            {
                dynamicCompanyId = response.CompanyId.ToString();
            }

            if (string.IsNullOrEmpty(dynamicCompanyId))
            {
                errorString = "Kunne ikke identificere din virksomhed ud fra din konto. Prøv igen.";
                return;
            }

            await LoadEmployeeData();
        }
        catch (Exception ex)
        {
            var errorHandler = ex.InnerException ?? ex;
            errorString = $"Fejl under initialisering: {errorHandler.Message}";
            Console.WriteLine(errorString);
        }
    }

    private async Task LoadEmployeeData()
    {
        if (!string.IsNullOrEmpty(errorString)) return;

        try
        {
            employees = await Http.GetFromJsonAsync<List<CompanyEmployeeModel>>("api/employee/employee-company");
        }
        catch (Exception ex)
        {
            errorString = $"Fejl ved hentning af medarbejdere: {ex.Message}";
        }
    }

    private async Task LoadProjectData()
    {
        if (string.IsNullOrEmpty(dynamicCompanyId) || !string.IsNullOrEmpty(errorString)) return;
        try
        {
            projects = await Http.GetFromJsonAsync<List<CompanyProjectModel>>($"api/project/company/{dynamicCompanyId}");
        }
        catch (Exception ex)
        {
            var errorHandler = ex.InnerException ?? ex;
            errorString = $"Fejl ved hentning af projekter: {errorHandler.Message}";
            Console.WriteLine(errorString);
        }
    }

    private async Task SwitchTab(string tabName)
    {
        if (!string.IsNullOrEmpty(errorString)) return;

        activeTab = tabName;

        if (activeTab == "employees")
        {
            projects = null;
            await LoadEmployeeData();
        }
        else if (activeTab == "projects")
        {
            employees = null;
            await LoadProjectData();
        }
    }

    private void NavigateToEmployeeDetails(Guid employeeId)
    {
        Navigation.NavigateTo($"/specific-employee-admin/{employeeId}");
    }
    private void NavigateToProjectDetails(Guid projectId)
    {
        Navigation.NavigateTo($"/specific-project-admin/{projectId}");
    }

    public class CompanyResponse
    {
        public Guid CompanyId { get; set; }
    }
}