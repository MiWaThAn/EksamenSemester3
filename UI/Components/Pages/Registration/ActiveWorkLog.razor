@page "/worklog/active"
@inject RegistrationService RegistrationService
@inject IAuthService authService
@using UI.Services.Registration
@using Shared.Item.Registrations.DTOs
@using Shared.Item.Registrations.Commands
@using Shared.Item.Registrations.Commands.Time
@using Shared.Item.ProjectActivity
@using Shared.Item.Registrations.Commands.Expenses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using UI.Services.Auth
@using Shared.Model
@attribute [Authorize]

@if (isLoading)
{
    <div class="flex items-center justify-center py-20">
        <div class="animate-spin h-10 w-10 border-4 border-indigo-300 border-t-indigo-600 rounded-full"></div>
    </div>
}
else
{
    <div class="lg:col-span-2 space-y-6">
        <div class="
            relative
            overflow-hidden
            rounded-3xl
            bg-gradient-to-br
            from-indigo-600
            via-indigo-700
            to-violet-700
            p-8
            shadow-xl
        ">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div>

                        @if (activeLog != null)
                        {
                            <div class="text-sm text-indigo-100 mt-1">
                                Startet: @activeLog.ClockInTime.ToShortTimeString()
                            </div>
                        }
                    </div>

                    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-700 p-8 shadow-2xl">

                        <div>

                            <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
                            <div class="absolute -left-20 -bottom-20 h-72 w-72 rounded-full bg-cyan-400/10 blur-3xl"></div>

                            @if (activeLog == null)
                            {
                                <div class="container-fluid px-0">

                                    <div class="mb-3">
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis px-3 py-2">
                                            <span class="me-2">●</span>
                                            Ikke stemplet ind
                                        </span>
                                    </div>

                                    <h2 class="display-5 fw-bold text-white mb-2">
                                        Start arbejdsdag
                                    </h2>

                                    <p class="lead text-light opacity-75 mb-4">
                                        Vælg projekt og aktivitet for at begynde registrering.
                                    </p>

                                    <div class="card border-0 shadow-lg bg-white bg-opacity-10">

                                        <div class="card-body p-4 p-lg-5">

                                            <div class="row g-4">

                                                <div class="col-12 col-lg-6">

                                                    <label class="form-label fw-semibold text-white">
                                                        Projekt
                                                    </label>

                                                    <select value="@selectedProjectId"
                                                    @onchange="OnProjectChanged"
                                                    class="form-select form-select-lg">

                                                        <option value="@Guid.Empty">
                                                            -- Vælg Projekt --
                                                        </option>

                                                        @foreach (var project in Projects)
                                                        {
                                                            <option value="@project.ProjectId">
                                                                @project.ProjectName
                                                            </option>
                                                        }

                                                    </select>

                                                </div>

                                                <div class="col-12 col-lg-6">

                                                    <label class="form-label fw-semibold text-white">
                                                        Aktivitet
                                                    </label>

                                                    <select @bind="selectedActivityId"
                                                    class="form-select form-select-lg">

                                                        <option value="@Guid.Empty">
                                                            -- Vælg Aktivitet --
                                                        </option>

                                                        @foreach (var activity in ProjectActivities)
                                                        {
                                                            <option value="@activity.ProjectActivityId">
                                                                @activity.ActivityName
                                                            </option>
                                                        }

                                                    </select>

                                                </div>

                                            </div>

                                            <div class="mt-4">

                                                <button @onclick="HandleStartWork"
                                                disabled="@(selectedProjectId == Guid.Empty || selectedActivityId == Guid.Empty)"
                                                class="btn btn-success btn-lg px-5 shadow">

                                                    <span class="me-2">▶</span>

                                                    Start Registrering

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="relative z-10 flex flex-col gap-8">

                                    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">

                                        <div>

                                            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-500/15 px-4 py-2 backdrop-blur-xl">

                                                <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-emerald-400"></span>

                                                <span class="text-sm font-medium text-white">
                                                    Aktiv Registrering
                                                </span>

                                            </div>

                                            <h2 class="mt-5 text-3xl font-bold tracking-tight text-white md:text-5xl">
                                                @activeLog.Status
                                            </h2>

                                            <p class="mt-2 text-indigo-100">
                                                Din arbejdsregistrering er aktiv.
                                            </p>

                                        </div>
                                        <div class="row g-3">

                                            <div class="col-12 col-md-6 col-lg-3">
                                                <button class="btn btn-secondary w-100"
                                                @onclick="HandleTakeBreak">
                                                    ⏸ Pause
                                                </button>
                                            </div>

                                            <div class="col-12 col-md-6 col-lg-3">
                                                <button class="btn btn-primary w-100"
                                                @onclick="HandleResumeWork">
                                                    ▶ Genoptag
                                                </button>
                                            </div>

                                            <div class="col-12 col-md-6 col-lg-3">
                                                <button class="btn btn-warning w-100"
                                                @onclick="HandleStopWork">
                                                    ■ Stop
                                                </button>
                                            </div>

                                            <div class="col-12 col-md-6 col-lg-3">
                                                <button class="btn btn-danger w-100"
                                                @onclick="HandleClockOut">
                                                    ⏻ Stempel Ud
                                                </button>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="grid gap-4 sm:grid-cols-3">

                                        <div class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
                                            <div class="text-xs uppercase tracking-widest text-indigo-200">
                                                Startet
                                            </div>

                                            <div class="mt-2 text-3xl font-bold text-white">
                                                @activeLog.ClockInTime.ToShortTimeString()
                                            </div>
                                        </div>

                                        <div class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
                                            <div class="text-xs uppercase tracking-widest text-indigo-200">
                                                Registreringer
                                            </div>

                                            <div class="mt-2 text-3xl font-bold text-white">
                                                @activeLog.TimeRegistrations.Count
                                            </div>
                                        </div>

                                        <div class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
                                            <div class="text-xs uppercase tracking-widest text-indigo-200">
                                                Udlæg
                                            </div>

                                            <div class="mt-2 text-3xl font-bold text-white">
                                                @(activeLog.ExpenseRegistrations?.Count ?? 0)
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-4">

                <div class="col-lg-8">


                    <div class="card border-0 shadow-sm mb-4">

                        <div class="card-body p-4">

                            <h3 class="card-title fw-bold mb-1">
                                Hurtige Handlinger
                            </h3>

                            <p class="text-muted mb-4">
                                Efterregistrer timer eller udlæg.
                            </p>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <button @onclick="() => showManualTimeModal = true"
                                    class="btn btn-light border w-100 text-start p-4 h-100">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="rounded-3 bg-primary bg-opacity-10 d-flex align-items-center justify-content-center"
                                            style="width:60px;height:60px;">
                                                <span class="fs-3">⏱</span>
                                            </div>

                                            <div>
                                                <div class="fw-semibold fs-5">
                                                    Registrer Tid
                                                </div>

                                                <div class="text-muted">
                                                    Tilføj arbejdstimer
                                                </div>
                                            </div>

                                        </div>

                                    </button>

                                </div>

                                <div class="col-md-6">

                                    <button @onclick="() => showExpenseModal = true"
                                    class="btn btn-light border w-100 text-start p-4 h-100">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="rounded-3 bg-success bg-opacity-10 d-flex align-items-center justify-content-center"
                                            style="width:60px;height:60px;">
                                                <span class="fs-3">💳</span>
                                            </div>

                                            <div>
                                                <div class="fw-semibold fs-5">
                                                    Registrer Udlæg
                                                </div>

                                                <div class="text-muted">
                                                    Tilføj udgift
                                                </div>
                                            </div>

                                        </div>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-4">

                            <h3 class="fw-bold mb-4">
                                Registrerede intervaller i dag
                            </h3>

                            @if (activeLog == null || !activeLog.TimeRegistrations.Any())
                            {
                                <div class="alert alert-light border mb-0">
                                    Ingen registreringer fundet.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3">

                                    @foreach (var timeReg in activeLog.TimeRegistrations)
                                    {
                                        <div class="card border">

                                            <div class="card-body">

                                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                                                    <div>
                                                        <h5 class="mb-1">
                                                            @timeReg.ProjectName
                                                        </h5>

                                                        <div class="text-muted small">
                                                            @timeReg.ProjectActivityName
                                                        </div>
                                                    </div>

                                                    <button @onclick="() => HandleRemoveRegistration(timeReg.Id)"
                                                    class="btn btn-outline-danger btn-sm">
                                                        Slet
                                                    </button>

                                                </div>

                                                <hr />

                                                <div class="d-flex flex-column gap-2">

                                                    @foreach (var inter in timeReg.Intervals)
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center border rounded p-3">

                                                            <div class="fw-medium">
                                                                @(inter.IsBreak ? "⏸ Pause" : "▶ Arbejde")
                                                            </div>

                                                            <div class="text-muted">
                                                                @inter.StartTime.ToShortTimeString()
                                                                →
                                                                @inter.EndTime?.ToShortTimeString()
                                                            </div>

                                                        </div>
                                                    }

                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="d-flex flex-column gap-4">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body">

                                <h4 class="fw-bold mb-3">
                                    Oversigt
                                </h4>

                                <div class="d-flex flex-column gap-3">

                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">
                                            Aktiv registrering
                                        </span>

                                        @if (activeLog != null && activeLog.TimeRegistrations.Any())
                                        {
                                            <span class="badge bg-success">
                                                Ja
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Nej
                                            </span>
                                        }
                                    </div>

                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">
                                            Registreringer i dag
                                        </span>

                                        <strong>
                                            @(activeLog?.TimeRegistrations.Count ?? 0)
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="card border-0 shadow-sm">

                            <div class="card-body">

                                <h4 class="fw-bold mb-3">
                                    Udgifter
                                </h4>

                                @if (activeLog == null ||
                                                                                activeLog.ExpenseRegistrations == null ||
                                                                                !activeLog.ExpenseRegistrations.Any())
                                {
                                    <div class="alert alert-light border mb-0">
                                        Ingen udlæg registreret.
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">

                                        @foreach (var ex in activeLog.ExpenseRegistrations)
                                        {
                                            <div class="list-group-item px-0">

                                                <div class="d-flex justify-content-between align-items-center">

                                                    <span>
                                                        @ex.ExpenseName
                                                    </span>

                                                    <span class="fw-semibold text-success">
                                                        @ex.Amount.ToString("C2")
                                                    </span>

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
}
















@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="mt-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-sm">@errorMessage</div>
}
@if (showManualTimeModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">
                        ⏱ Registrer Tid
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="() => showManualTimeModal = false">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Projekt
                            </label>

                            <select @bind="manualSelectedProjectId"
                                    class="form-select">

                                <option value="@Guid.Empty">
                                    -- Vælg Projekt --
                                </option>

                                @foreach (var p in Projects)
                                {
                                    <option value="@p.ProjectId">
                                        @p.ProjectName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Aktivitet
                            </label>

                            <select @bind="manualSelectedActivityId"
                                    class="form-select">

                                <option value="@Guid.Empty">
                                    -- Vælg Aktivitet --
                                </option>

                                @foreach (var a in ManualProjectActivities)
                                {
                                    <option value="@a.ProjectActivityId">
                                        @a.ActivityName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Dato
                            </label>

                            <input type="date"
                                   @bind="manualDate"
                                   class="form-control" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Type
                            </label>

                            <div class="form-check mt-2">

                                <input class="form-check-input"
                                       type="checkbox"
                                       @bind="manualIsWork" />

                                <label class="form-check-label">
                                    Arbejde
                                </label>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Starttid
                            </label>

                            <input type="time"
                                   @bind="manualStartTime"
                                   class="form-control" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Sluttid
                            </label>

                            <input type="time"
                                   @bind="manualEndTime"
                                   class="form-control" />

                        </div>

                        <div class="col-12">

                            <label class="form-label">
                                Beskrivelse
                            </label>

                            <textarea @bind="manualTimeDescription"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Beskrivelse">
                            </textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-outline-secondary"
                            @onclick="() => showManualTimeModal = false">

                        Annuller

                    </button>

                    <button @onclick="HandleAddManualTime"
                            class="btn btn-primary">

                        Gem Tid

                    </button>

                </div>

            </div>

        </div>

    </div>
}
@if (showExpenseModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">
                        💳 Registrer Udlæg
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="() => showExpenseModal = false">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Projekt
                            </label>

                            <select @bind="manualExpenseProjectId"
                                    class="form-select">

                                <option value="@Guid.Empty">
                                    -- Vælg Projekt --
                                </option>

                                @foreach (var p in Projects)
                                {
                                    <option value="@p.ProjectId">
                                        @p.ProjectName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Aktivitet
                            </label>

                            <select @bind="manualExpenseActivityId"
                                    class="form-select">

                                <option value="@Guid.Empty">
                                    -- Vælg Aktivitet --
                                </option>

                                @foreach (var a in ManualExpenseProjectActivities)
                                {
                                    <option value="@a.ProjectActivityId">
                                        @a.ActivityName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Beløb
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    kr.
                                </span>

                                <input type="number"
                                       step="0.01"
                                       @bind="expenseAmount"
                                       class="form-control"
                                       placeholder="0,00" />

                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Udgiftstype
                            </label>

                            <select @bind="selectedExpenseId"
                                    class="form-select">

                                <option value="@Guid.Empty">
                                    -- Udgiftstype --
                                </option>

                                @foreach (var expense in CompanyExpenses)
                                {
                                    <option value="@expense.Id">
                                        @expense.Name
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-12">

                            <label class="form-label">
                                Beskrivelse
                            </label>

                            <textarea @bind="expenseDescription"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Beskrivelse af udgiften">
                            </textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-outline-secondary"
                            @onclick="() => showExpenseModal = false">

                        Annuller

                    </button>

                    <button @onclick="HandleAddManualExpense"
                            class="btn btn-success">

                        Gem Udgift

                    </button>

                </div>

            </div>

        </div>

    </div>
}
@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private List<ProjectDto> Projects = new();
    private List<ProjectActivityDto> ProjectActivities = new();
    private List<CompanyExpenseModel> CompanyExpenses = new();
    private WorkLogDto? activeLog;
    private Guid UserId;
    private Guid CompanyId;
    private bool showManualTimeModal;
    private bool showExpenseModal;

    private Guid selectedProjectId = Guid.Empty;
    private Guid selectedActivityId = Guid.Empty;
    private Guid selectedExpenseId = Guid.Empty;

    // Nye specifikke tilstande til dine præcise Commands
    private DateTime manualDate = DateTime.Today;
    private DateTime manualStartTime = DateTime.Today.AddHours(8);
    private DateTime manualEndTime = DateTime.Today.AddHours(16);
    private string manualTimeDescription = string.Empty;
    private bool manualIsWork = true;
    private Guid manualSelectedProjectId = Guid.Empty;
    private Guid manualSelectedActivityId = Guid.Empty;
    private List<ProjectActivityDto> ManualProjectActivities = new();

    private Guid manualExpenseProjectId = Guid.Empty;
    private Guid manualExpenseActivityId = Guid.Empty;
    private List<ProjectActivityDto> ManualExpenseProjectActivities = new();

    private decimal expenseAmount;
    private string expenseDescription = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var guid = await authService.GetUserIdAsync();
        UserId = Guid.Parse(guid);
        var companyId = await authService.GetComapnyIdAsync();
        CompanyId = Guid.Parse(companyId);
        await LoadActiveWorkLog();
        var fetchedProjects = await RegistrationService.GetProjects(CancellationToken.None);
        Projects = fetchedProjects?.ToList() ?? new();
        var fetchedExpenses = await RegistrationService.GetCompanyExpenses(CompanyId, CancellationToken.None);
        CompanyExpenses = fetchedExpenses?.ToList() ?? new();
    }

    private async Task OnManualProjectChanged(ChangeEventArgs e)
    {
        ManualProjectActivities.Clear();
        if (Guid.TryParse(e.Value?.ToString(), out Guid pid))
        {
            manualSelectedProjectId = pid;
            if (manualSelectedProjectId != Guid.Empty)
            {
                var activities = await RegistrationService.GetProjectActivities(manualSelectedProjectId, CancellationToken.None);
                ManualProjectActivities = activities?.ToList() ?? new();
            }
        }
    }

    private async Task ManualSelectedProjectIdChanged()
    {
        ManualProjectActivities.Clear();
        if (manualSelectedProjectId != Guid.Empty)
        {
            var activities = await RegistrationService.GetProjectActivities(manualSelectedProjectId, CancellationToken.None);
            ManualProjectActivities = activities?.ToList() ?? new();
        }
    }

    private async Task OnManualExpenseProjectChanged(ChangeEventArgs e)
    {
        ManualExpenseProjectActivities.Clear();
        if (Guid.TryParse(e.Value?.ToString(), out Guid pid))
        {
            manualExpenseProjectId = pid;
            if (manualExpenseProjectId != Guid.Empty)
            {
                var activities = await RegistrationService.GetProjectActivities(manualExpenseProjectId, CancellationToken.None);
                ManualExpenseProjectActivities = activities?.ToList() ?? new();
            }
        }
    }

    private async Task ManualExpenseProjectIdChanged()
    {
        ManualExpenseProjectActivities.Clear();
        if (manualExpenseProjectId != Guid.Empty)
        {
            var activities = await RegistrationService.GetProjectActivities(manualExpenseProjectId, CancellationToken.None);
            ManualExpenseProjectActivities = activities?.ToList() ?? new();
        }
    }

    private async Task LoadActiveWorkLog()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            activeLog = await RegistrationService.GetActiveWorkLog(UserId, CancellationToken.None);
        }
        catch (Exception)
        {
            errorMessage = "Kunne ikke hente din aktive logfil.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleStartWork()
    {
        var command = new StartWorkCommand(UserId, selectedProjectId, selectedActivityId);
        var result = await RegistrationService.StartWork(command, CancellationToken.None);
        if (result.Success)
        {
            ResetSelection();
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        selectedActivityId = Guid.Empty;
        ProjectActivities.Clear();

        if (Guid.TryParse(e.Value?.ToString(), out Guid projectId))
        {
            selectedProjectId = projectId;
            if (selectedProjectId != Guid.Empty)
            {
                var activities = await RegistrationService.GetProjectActivities(selectedProjectId, CancellationToken.None);
                ProjectActivities = activities?.ToList() ?? new();
            }
        }
    }

    private async Task HandleSwitchActivity()
    {
        if (activeLog == null || selectedProjectId == Guid.Empty || selectedActivityId == Guid.Empty) return;
        var result = await RegistrationService.SwitchActivity(UserId, selectedProjectId, selectedActivityId, CancellationToken.None);
        if (result.Success) { ResetSelection(); await LoadActiveWorkLog(); }
        else errorMessage = result.Message;
    }

    private async Task HandleSwitchProject()
    {
        if (activeLog == null || selectedProjectId == Guid.Empty || selectedActivityId == Guid.Empty) return;
        var result = await RegistrationService.SwitchProject(UserId, activeLog.Id, selectedProjectId, selectedActivityId, CancellationToken.None);
        if (result.Success) { ResetSelection(); await LoadActiveWorkLog(); }
        else errorMessage = result.Message;
    }

    private async Task HandleAddManualTime()
    {
        if (activeLog == null || selectedProjectId == Guid.Empty) return;


        var startDateTime = manualDate.Date.Add(manualStartTime.TimeOfDay);
        var endDateTime = manualDate.Date.Add(manualEndTime.TimeOfDay);
        Guid? activityId = manualSelectedActivityId == Guid.Empty ? null : manualSelectedActivityId;

        var command = new ManualTimeRegistrationCommand(
            UserId,
            selectedProjectId,
            activityId,
            startDateTime,
            endDateTime,
            manualTimeDescription,
            manualDate,
            manualIsWork
        );

        var result = await RegistrationService.CreateTimeRegistration(UserId, activeLog.Id, command, CancellationToken.None);
        if (result.Success)
        {
            showManualTimeModal = false;
            manualTimeDescription = string.Empty;
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }


    private async Task HandleAddManualExpense()
    {
        if (activeLog == null || manualExpenseProjectId == Guid.Empty || expenseAmount <= 0) return;

        Guid? activityId = manualExpenseActivityId == Guid.Empty ? null : manualExpenseActivityId;
        var command = new CreateExpenseCommand(
            UserId,
            expenseAmount,
            expenseDescription,
            selectedExpenseId,
            CompanyExpenses.FirstOrDefault(e => e.Id == selectedExpenseId)?.Name,
            activityId,
            manualExpenseProjectId
        );

        var result = await RegistrationService.CreateExpenseRegistration(CompanyId, activeLog.Id, command, CancellationToken.None);
        if (result.Success)
        {
            showExpenseModal = false;
            expenseAmount = 0;
            expenseDescription = string.Empty;
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }

    private async Task HandleRemoveRegistration(Guid regId)
    {
        if (activeLog == null) return;
        var result = await RegistrationService.RemoveTimeRegistration(UserId, activeLog.Id, regId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleRemoveExpense(Guid expenseId)
    {
        if (activeLog == null) return;
        var result = await RegistrationService.RemoveExpenseRegistration(UserId, activeLog.Id, expenseId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleTakeBreak()
    {
        var result = await RegistrationService.TakeBreak(UserId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleResumeWork()
    {
        var result = await RegistrationService.ResumeWork(UserId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleClockOut()
    {
        var result = await RegistrationService.ClockOut(UserId, CancellationToken.None);
        if (result.Success)
        {
            if (activeLog != null) await RegistrationService.SubmitWorkLogForApproval(UserId, activeLog.Id, CancellationToken.None);
            activeLog = null;
            ResetSelection();
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }

    private async Task HandleStopWork()
    {
        if (activeLog == null) return;
        var result = await RegistrationService.EndWork(UserId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private void ResetSelection()
    {
        selectedProjectId = Guid.Empty;
        selectedActivityId = Guid.Empty;
        ProjectActivities.Clear();
    }
}