@page "/worklog/active"
@inject RegistrationService RegistrationService
@inject IAuthService authService
@using UI.Services.Registration
@using Shared.Item.Registrations.DTOs
@using Shared.Item.Registrations.Commands
@using Shared.Item.Registrations.Commands.Time
@using Shared.Item.ProjectActivity
@using Shared.Item.Registrations.Commands.Expenses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using UI.Services.Auth
@using Shared.Model
@attribute [Authorize]

<div class="max-w-4xl mx-auto p-6">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800">Arbejdsposter</h1>
            <p class="text-sm text-slate-500">Se, rediger og afterregistrer dine arbejdstimer og udlæg</p>
        </div>
        <div class="flex items-center space-x-3">
            <button class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg shadow" @onclick="LoadActiveWorkLog">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M4 3a1 1 0 000 2h12a1 1 0 100-2H4z" /><path fill-rule="evenodd" d="M3 7a2 2 0 012-2h10a2 2 0 012 2v6a5 5 0 11-10 0H5a2 2 0 01-2-2V7z" clip-rule="evenodd" /></svg>
                Opdater
            </button>
            <span class="text-xs text-slate-500">@DateTime.UtcNow.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="animate-spin h-10 w-10 border-4 border-indigo-300 border-t-indigo-600 rounded-full"></div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main card -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-2xl shadow-md p-6 border">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <div>
                                <div class="text-sm text-slate-500">Status</div>
                                <div class="text-lg font-semibold text-slate-800">@((activeLog != null) ? activeLog.Status : "Ingen Aktiv Log")</div>
                                @if (activeLog != null)
                                {
                                    <div class="text-xs text-slate-400">Startet: @activeLog.ClockInTime.ToShortTimeString()</div>
                                }
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            @if (activeLog == null)
                            {
                                <div class="space-y-2 w-56">
                                    <label class="block text-xs font-medium text-slate-600">Projekt</label>
                                    <select value="@selectedProjectId" @onchange="OnProjectChanged" class="w-full p-2 border rounded-lg">
                                        <option value="@Guid.Empty">-- Vælg Projekt --</option>
                                        @foreach (var project in Projects)
                                        {
                                            <option value="@project.ProjectId">@project.ProjectName</option>
                                        }
                                    </select>

                                    <label class="block text-xs font-medium text-slate-600">Aktivitet</label>
                                    <select @bind="selectedActivityId" class="w-full p-2 border rounded-lg">
                                        <option value=@Guid.Empty>-- Vælg Aktivitet --</option>
                                        @foreach (var activity in ProjectActivities)
                                        {
                                            <option value=@activity.ProjectActivityId>@activity.ActivityName</option>
                                        }
                                    </select>
                                </div>

                                <div class="flex flex-col">
                                    <button @onclick="HandleStartWork" disabled="@(selectedProjectId == Guid.Empty || selectedActivityId == Guid.Empty)" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-medium">Stempel Ind</button>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2">
                                    <button @onclick="HandleTakeBreak" class="px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg">Pause</button>
                                    <button @onclick="HandleResumeWork" class="px-3 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-lg">Genoptag</button>
                                    <button @onclick="HandleStopWork" class="px-3 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg">Stop</button>
                                    <button @onclick="HandleClockOut" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-lg font-semibold shadow">Stempel Ud</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Manual entries -->
                <div class="bg-white rounded-2xl shadow-sm p-6 border space-y-4">
                    <h3 class="text-lg font-semibold">Manuel Efterregistrering</h3>
                    <p class="text-sm text-slate-400">Tilføj tid eller udlæg hurtigt.</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-4 bg-slate-50 rounded-lg">
                            <h4 class="font-medium text-slate-700 mb-2">Tilføj Tid</h4>
                            <div class="grid grid-cols-1 gap-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <select @bind="manualSelectedProjectId" class="p-2 border rounded">
                                        <option value="@Guid.Empty">-- Vælg Projekt --</option>
                                        @foreach (var p in Projects)
                                        {
                                            <option value="@p.ProjectId">@p.ProjectName</option>
                                        }
                                    </select>
                                    <select @bind="manualSelectedActivityId" class="p-2 border rounded">
                                        <option value="@Guid.Empty">-- Vælg Aktivitet --</option>
                                        @foreach (var a in ManualProjectActivities)
                                        {
                                            <option value="@a.ProjectActivityId">@a.ActivityName</option>
                                        }
                                    </select>
                                </div>

                                <div class="grid grid-cols-2 gap-3">
                                    <input type="date" @bind="manualDate" class="p-2 border rounded" />
                                    <div class="flex items-center">
                                        <label class="inline-flex items-center text-sm">
                                            <input type="checkbox" @bind="manualIsWork" class="mr-2" /> Arbejde
                                        </label>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-3">
                                    <input type="time" @bind="manualStartTime" class="p-2 border rounded" />
                                    <input type="time" @bind="manualEndTime" class="p-2 border rounded" />
                                </div>

                                <input type="text" @bind="manualTimeDescription" placeholder="Beskrivelse" class="p-2 border rounded" />
                                <button @onclick="HandleAddManualTime" class="w-full mt-2 px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded">Gem Tid</button>
                            </div>
                        </div>

                        <div class="p-4 bg-slate-50 rounded-lg">
                            <h4 class="font-medium text-slate-700 mb-2">Tilføj Udgift</h4>
                            <div class="grid grid-cols-1 gap-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <select @bind="manualExpenseProjectId" class="p-2 border rounded">
                                        <option value="@Guid.Empty">-- Vælg Projekt --</option>
                                        @foreach (var p in Projects)
                                        {
                                            <option value="@p.ProjectId">@p.ProjectName</option>
                                        }
                                    </select>
                                    <select @bind="manualExpenseActivityId" class="p-2 border rounded">
                                        <option value=@Guid.Empty>-- Vælg Aktivitet --</option>
                                        @foreach (var a in ManualExpenseProjectActivities)
                                        {
                                            <option value=@a.ProjectActivityId>@a.ActivityName</option>
                                        }
                                    </select>
                                </div>

                                <div class="grid grid-cols-2 gap-3">
                                    <input type="number" step="0.01" @bind="expenseAmount" placeholder="Beløb" class="p-2 border rounded" />
                                    <select @bind="selectedExpenseId" class="p-2 border rounded">
                                        <option value=@Guid.Empty>-- Udgiftstype --</option>
                                        @foreach (var expense in CompanyExpenses)
                                        {
                                            <option value=@expense.Id>@expense.Name</option>
                                        }
                                    </select>
                                </div>

                                <input type="text" @bind="expenseDescription" placeholder="Beskrivelse" class="p-2 border rounded" />
                                <button @onclick="HandleAddManualExpense" class="w-full mt-2 px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded">Gem Udgift</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Today's registrations -->
                <div class="bg-white rounded-2xl shadow p-6 border">
                    <h3 class="text-lg font-semibold mb-3">Registrerede intervaller i dag</h3>
                    @if (activeLog == null || !activeLog.TimeRegistrations.Any())
                    {
                        <div class="text-sm text-slate-400 italic">Ingen registreringer fundet.</div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var timeReg in activeLog.TimeRegistrations)
                            {
                                <div class="flex items-center justify-between p-3 border rounded-lg bg-slate-50">
                                    <div>
                                        <div class="font-semibold">@timeReg.ProjectName</div>
                                        <div class="text-xs text-slate-500">@timeReg.ProjectActivityName</div>
                                    </div>
                                    <div class="text-sm text-slate-600 text-right">
                                        @foreach (var inter in timeReg.Intervals)
                                        {
                                            <div class="">@(inter.IsBreak ? "Pause" : "Arbejde") - @inter.StartTime.ToShortTimeString() - @inter.EndTime?.ToShortTimeString()</div>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button @onclick="() => HandleRemoveRegistration(timeReg.Id)" class="text-rose-600 hover:text-rose-800">Slet</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl shadow p-4 border">
                    <h4 class="font-semibold">Oversigt</h4>
                    <div class="mt-3 text-sm text-slate-600">
                        <div>Aktiv registrering: <strong>@(activeLog != null && activeLog.TimeRegistrations.Any() ? "Ja" : "Nej")</strong></div>
                        <div class="mt-2">Antal registreringer i dag: <strong>@(activeLog?.TimeRegistrations.Count ?? 0)</strong></div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow p-4 border">
                    <h4 class="font-semibold">Udgifter</h4>
                    @if (activeLog == null || activeLog.ExpenseRegistrations == null || !activeLog.ExpenseRegistrations.Any())
                    {
                        <div class="text-sm text-slate-400 italic mt-2">Ingen udlæg registreret.</div>
                    }
                    else
                    {
                        <ul class="mt-2 space-y-2 text-sm">
                            @foreach (var ex in activeLog.ExpenseRegistrations)
                            {
                                <li class="flex justify-between items-center">
                                    <span>@ex.ExpenseName</span>
                                    <span class="text-emerald-700">@ex.Amount.ToString("C2")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-sm">@errorMessage</div>
    }
</div>

@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private List<ProjectDto> Projects = new();
    private List<ProjectActivityDto> ProjectActivities = new();
    private List<CompanyExpenseModel> CompanyExpenses = new();
    private WorkLogDto? activeLog;
    private Guid UserId;
    private Guid CompanyId;

    private Guid selectedProjectId = Guid.Empty;
    private Guid selectedActivityId = Guid.Empty;
    private Guid selectedExpenseId = Guid.Empty;

    // Nye specifikke tilstande til dine præcise Commands
    private DateTime manualDate = DateTime.Today;
    private DateTime manualStartTime = DateTime.Today.AddHours(8);
    private DateTime manualEndTime = DateTime.Today.AddHours(16);
    private string manualTimeDescription = string.Empty;
    private bool manualIsWork = true;
    private Guid manualSelectedProjectId = Guid.Empty;
    private Guid manualSelectedActivityId = Guid.Empty;
    private List<ProjectActivityDto> ManualProjectActivities = new();

    private Guid manualExpenseProjectId = Guid.Empty;
    private Guid manualExpenseActivityId = Guid.Empty;
    private List<ProjectActivityDto> ManualExpenseProjectActivities = new();

    private decimal expenseAmount;
    private string expenseDescription = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var guid = await authService.GetUserIdAsync();
        UserId = Guid.Parse(guid);
        var companyId = await authService.GetComapnyIdAsync();
        CompanyId = Guid.Parse(companyId);
        await LoadActiveWorkLog();
        var fetchedProjects = await RegistrationService.GetProjects(CancellationToken.None);
        Projects = fetchedProjects?.ToList() ?? new();
        var fetchedExpenses = await RegistrationService.GetCompanyExpenses(CompanyId,CancellationToken.None);
        CompanyExpenses = fetchedExpenses?.ToList() ?? new();
    }

    private async Task OnManualProjectChanged(ChangeEventArgs e)
    {
        ManualProjectActivities.Clear();
        if (Guid.TryParse(e.Value?.ToString(), out Guid pid))
        {
            manualSelectedProjectId = pid;
            if (manualSelectedProjectId != Guid.Empty)
            {
                var activities = await RegistrationService.GetProjectActivities(manualSelectedProjectId, CancellationToken.None);
                ManualProjectActivities = activities?.ToList() ?? new();
            }
        }
    }

    // Called when manualSelectedProjectId changes via binding
    private async Task ManualSelectedProjectIdChanged()
    {
        ManualProjectActivities.Clear();
        if (manualSelectedProjectId != Guid.Empty)
        {
            var activities = await RegistrationService.GetProjectActivities(manualSelectedProjectId, CancellationToken.None);
            ManualProjectActivities = activities?.ToList() ?? new();
        }
    }

    private async Task OnManualExpenseProjectChanged(ChangeEventArgs e)
    {
        ManualExpenseProjectActivities.Clear();
        if (Guid.TryParse(e.Value?.ToString(), out Guid pid))
        {
            manualExpenseProjectId = pid;
            if (manualExpenseProjectId != Guid.Empty)
            {
                var activities = await RegistrationService.GetProjectActivities(manualExpenseProjectId, CancellationToken.None);
                ManualExpenseProjectActivities = activities?.ToList() ?? new();
            }
        }
    }

    private async Task ManualExpenseProjectIdChanged()
    {
        ManualExpenseProjectActivities.Clear();
        if (manualExpenseProjectId != Guid.Empty)
        {
            var activities = await RegistrationService.GetProjectActivities(manualExpenseProjectId, CancellationToken.None);
            ManualExpenseProjectActivities = activities?.ToList() ?? new();
        }
    }

    private async Task LoadActiveWorkLog()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            activeLog = await RegistrationService.GetActiveWorkLog(UserId, CancellationToken.None);
        }
        catch (Exception)
        {
            errorMessage = "Kunne ikke hente din aktive logfil.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleStartWork()
    {
        var command = new StartWorkCommand(UserId, selectedProjectId, selectedActivityId);
        var result = await RegistrationService.StartWork(command, CancellationToken.None);
        if (result.Success)
        {
            ResetSelection();
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        selectedActivityId = Guid.Empty;
        ProjectActivities.Clear();

        if (Guid.TryParse(e.Value?.ToString(), out Guid projectId))
        {
            selectedProjectId = projectId;
            if (selectedProjectId != Guid.Empty)
            {
                var activities = await RegistrationService.GetProjectActivities(selectedProjectId, CancellationToken.None);
                ProjectActivities = activities?.ToList() ?? new();
            }
        }
    }

    private async Task HandleSwitchActivity()
    {
        if (activeLog == null || selectedProjectId == Guid.Empty || selectedActivityId == Guid.Empty) return;
        var result = await RegistrationService.SwitchActivity(UserId, selectedProjectId, selectedActivityId, CancellationToken.None);
        if (result.Success) { ResetSelection(); await LoadActiveWorkLog(); }
        else errorMessage = result.Message;
    }

    private async Task HandleSwitchProject()
    {
        if (activeLog == null || selectedProjectId == Guid.Empty || selectedActivityId == Guid.Empty) return;
        var result = await RegistrationService.SwitchProject(UserId, activeLog.Id, selectedProjectId, selectedActivityId, CancellationToken.None);
        if (result.Success) { ResetSelection(); await LoadActiveWorkLog(); }
        else errorMessage = result.Message;
    }

    private async Task HandleAddManualTime()
    {
        if (activeLog == null || selectedProjectId == Guid.Empty) return;


        var startDateTime = manualDate.Date.Add(manualStartTime.TimeOfDay);
        var endDateTime = manualDate.Date.Add(manualEndTime.TimeOfDay);
        Guid? activityId = manualSelectedActivityId == Guid.Empty ? null : manualSelectedActivityId;

        var command = new ManualTimeRegistrationCommand(
            UserId,
            selectedProjectId,
            activityId,
            startDateTime,
            endDateTime,
            manualTimeDescription,
            manualDate,
            manualIsWork
        );

        var result = await RegistrationService.CreateTimeRegistration(UserId, activeLog.Id, command, CancellationToken.None);
        if (result.Success)
        {
            manualTimeDescription = string.Empty;
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }


    private async Task HandleAddManualExpense()
    {
        if (activeLog == null || manualExpenseProjectId == Guid.Empty || expenseAmount <= 0) return;

        Guid? activityId = manualExpenseActivityId == Guid.Empty ? null : manualExpenseActivityId;
        var command = new CreateExpenseCommand(
            UserId,
            expenseAmount,
            expenseDescription,
            selectedExpenseId,
            CompanyExpenses.FirstOrDefault(e=>e.Id == selectedExpenseId)?.Name,
            activityId,
            manualExpenseProjectId
        );

        var result = await RegistrationService.CreateExpenseRegistration(CompanyId, activeLog.Id, command, CancellationToken.None);
        if (result.Success)
        {
            expenseAmount = 0;
            expenseDescription = string.Empty;
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }

    private async Task HandleRemoveRegistration(Guid regId)
    {
        if (activeLog == null) return;
        var result = await RegistrationService.RemoveTimeRegistration(UserId, activeLog.Id, regId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleRemoveExpense(Guid expenseId)
    {
        if (activeLog == null) return;
        var result = await RegistrationService.RemoveExpenseRegistration(UserId, activeLog.Id, expenseId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleTakeBreak()
    {
        var result = await RegistrationService.TakeBreak(UserId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleResumeWork()
    {
        var result = await RegistrationService.ResumeWork(UserId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private async Task HandleClockOut()
    {
        var result = await RegistrationService.ClockOut(UserId, CancellationToken.None);
        if (result.Success)
        {
            if (activeLog != null) await RegistrationService.SubmitWorkLogForApproval(UserId, activeLog.Id, CancellationToken.None);
            activeLog = null;
            ResetSelection();
            await LoadActiveWorkLog();
        }
        else errorMessage = result.Message;
    }

    private async Task HandleStopWork()
    {
        if (activeLog == null) return;
        var result = await RegistrationService.EndWork(UserId, CancellationToken.None);
        if (result.Success) await LoadActiveWorkLog();
        else errorMessage = result.Message;
    }

    private void ResetSelection()
    {
        selectedProjectId = Guid.Empty;
        selectedActivityId = Guid.Empty;
        ProjectActivities.Clear();
    }
}