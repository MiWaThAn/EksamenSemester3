@page "/company/pending-approvals"
@inject RegistrationService RegistrationService
@using UI.Services.Registration
@using Shared.Item.Registrations.DTOs
@using Shared.Item.Registrations.Commands
@using Shared.Item.Registrations.Commands.Time
@using Shared.Item.Registrations.Commands.Expenses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container mx-auto p-4 max-w-4xl">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-slate-800">Afventende Godkendelser</h2>
        <button @onclick="LoadPendingLogs" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition">
            Opdater Liste
        </button>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center my-12">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (pendingLogs == null || !pendingLogs.Any())
    {
        <div class="bg-slate-50 border border-dashed rounded-xl p-8 text-center text-slate-500">
            Der er i øjeblikket ingen tidsregistreringer, der venter på godkendelse.
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var log in pendingLogs)
            {
                <div class="bg-white rounded-xl shadow border border-slate-100 overflow-hidden">
                    <div class="bg-slate-50 p-4 border-b border-slate-100 flex justify-between items-center flex-wrap gap-2">
                        <div>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Medarbejder ID</span>
                            <span class="font-medium text-slate-700 text-sm">@log.AccountId</span>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Dato Oprettet</span>
                            <span class="text-sm text-slate-600">@log.ClockInTime.ToString("dd-MM-yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="p-4 space-y-4">
                        <div>
                            <h4 class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-2">Tidsregistreringer</h4>
                            <div class="bg-slate-50 rounded-lg p-2 divide-y divide-slate-200">
                                @foreach (var t in log.TimeRegistrations)
                                {
                                    <div class="p-2 text-sm flex justify-between">
                                        <div>
                                            <span class="font-semibold text-slate-700">@t.ProjectName</span>
                                            <span class="text-slate-400 mx-1">|</span>
                                            <span class="text-slate-600">@t.ProjectActivityName</span>
                                        </div>
                                        <span class="italic text-slate-500 text-xs">@t.Description</span>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (log.ExpenseRegistrations?.Any() == true)
                        {
                            <div>
                                <h4 class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-2">Udlæg & Udgifter</h4>
                                <div class="bg-amber-50/50 rounded-lg p-2 divide-y divide-amber-100">
                                    @foreach (var e in log.ExpenseRegistrations)
                                    {
                                        <div class="p-2 text-sm flex justify-between">
                                            <div>
                                                <span class="font-medium text-amber-900">@e.ExpenseName</span>
                                                <span class="text-xs text-amber-600 block">@e.Description</span>
                                            </div>
                                            <span class="font-bold text-amber-700">@e.Amount.ToString("C")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="flex justify-end gap-2 border-t pt-4 mt-2">
                            <button @onclick="() => PromptRejection(log.Id)" class="px-4 py-2 bg-rose-50 text-rose-600 hover:bg-rose-100 font-medium text-sm rounded-lg transition">
                                Afvis
                            </button>
                            <button @onclick="() => HandleApprove(log.Id)" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm rounded-lg transition shadow-sm">
                                Godkend
                            </button>
                        </div>

                        @if (activeRejectionLogId == log.Id)
                        {
                            <div class="bg-rose-50/50 p-3 rounded-lg border border-rose-100 mt-2 space-y-2">
                                <label class="text-xs font-bold text-rose-800 block">Årsag til afvisning:</label>
                                <input type="text" @bind="rejectionReason" placeholder="Indtast begrundelse..." class="w-full p-2 text-sm border border-rose-200 rounded-md bg-white" />
                                <div class="flex justify-end gap-2">
                                    <button @onclick="CancelRejection" class="px-3 py-1 text-xs text-slate-500 hover:text-slate-700">Annuller</button>
                                    <button @onclick="SubmitRejection" class="px-3 py-1 text-xs bg-rose-600 text-white rounded hover:bg-rose-700">Bekræft Afvisning</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-sm">
            @errorMessage
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private IEnumerable<WorkLogDto>? pendingLogs;

    private Guid companyAccountId = Guid.Parse("2ce98f72-7157-4562-b3fc-2c963f66af00");
    private Guid? activeRejectionLogId;
    private string rejectionReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingLogs();
    }

    private async Task LoadPendingLogs()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            pendingLogs = await RegistrationService.GetPendingWorkLogs(companyAccountId, CancellationToken.None);
        }
        catch (Exception)
        {
            errorMessage = "Fejl under hentning af afventende arbejdssedler.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleApprove(Guid logId)
    {
        var result = await RegistrationService.ApproveWorkLog(companyAccountId, logId, CancellationToken.None);
        if (result.Success) await LoadPendingLogs();
        else errorMessage = result.Message;
    }

    private void PromptRejection(Guid logId)
    {
        activeRejectionLogId = logId;
        rejectionReason = string.Empty;
    }

    private void CancelRejection()
    {
        activeRejectionLogId = null;
        rejectionReason = string.Empty;
    }

    private async Task SubmitRejection()
    {
        if (activeRejectionLogId == null || string.IsNullOrWhiteSpace(rejectionReason)) return;

        var result = await RegistrationService.RejectWorkLog(companyAccountId, activeRejectionLogId.Value, rejectionReason, CancellationToken.None);
        if (result.Success)
        {
            CancelRejection();
            await LoadPendingLogs();
        }
        else
        {
            errorMessage = result.Message;
        }
    }
}