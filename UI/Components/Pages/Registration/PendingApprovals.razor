@page "/company/pending-approvals"
@inject RegistrationService RegistrationService
@inject IAuthService authService
@using UI.Services.Registration
@using UI.Services.Auth
@using Shared.Item.Registrations.DTOs
@using Shared.Item.Registrations.Commands
@using Shared.Item.Registrations.Commands.Time
@using Shared.Item.Registrations.Commands.Expenses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-xl-10">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        Afventende Godkendelser
                    </h2>

                    <p class="text-muted mb-0">
                        Gennemgå og godkend medarbejdernes tidsregistreringer.
                    </p>
                </div>

                <button @onclick="LoadPendingLogs"
                        class="btn btn-outline-secondary">

                    Opdater Liste

                </button>

            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>

                </div>
            }
            else if (pendingLogs == null || !pendingLogs.Any())
            {
                <div class="card border-0 shadow-sm">

                    <div class="card-body text-center py-5">

                        <h5 class="text-muted mb-0">
                            Der er i øjeblikket ingen tidsregistreringer, der venter på godkendelse.
                        </h5>

                    </div>

                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-4">

                    @foreach (var log in pendingLogs)
                    {
                        <div class="card border-0 shadow-sm">

                            <div class="card-header bg-light">

                                <div class="row g-3 align-items-center">

                                    <div class="col-md-6">

                                        <div class="small text-uppercase text-muted fw-bold">
                                            Medarbejder
                                        </div>

                                        <div class="fw-semibold">
                                            @log.EmployeeName
                                        </div>
                                    </div>

                                    <div class="col-md-6 text-md-end">

                                        <div class="small text-uppercase text-muted fw-bold">
                                            Dato Oprettet
                                        </div>

                                        <div>
                                            @log.ClockInTime.ToString("dd-MM-yyyy HH:mm")
                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="card-body">

                                <h6 class="fw-bold mb-3">
                                    ⏱ Tidsregistreringer
                                </h6>

                                @if (log.TimeRegistrations.Any())
                                {
                                    <div class="list-group mb-4">

                                        @foreach (var t in log.TimeRegistrations)
                                        {
                                            <div class="list-group-item">

                                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">

                                                    <div>

                                                        <div class="fw-semibold">
                                                            @t.ProjectName
                                                        </div>

                                                        <div class="text-muted small">
                                                            @t.ProjectActivityName
                                                        </div>

                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(t.Description))
                                                    {
                                                        <span class="badge bg-light text-dark border">
                                                            @t.Description
                                                        </span>
                                                    }

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }

                                @if (log.ExpenseRegistrations?.Any() == true)
                                {
                                    <h6 class="fw-bold mb-3">
                                        💳 Udlæg & Udgifter
                                    </h6>

                                    <div class="list-group mb-4">

                                        @foreach (var e in log.ExpenseRegistrations)
                                        {
                                            <div class="list-group-item">

                                                <div class="d-flex justify-content-between align-items-start">

                                                    <div>

                                                        <div class="fw-semibold">
                                                            @e.ExpenseName
                                                        </div>

                                                        <div class="small text-muted">
                                                            @e.Description
                                                        </div>

                                                    </div>

                                                    <span class="badge bg-warning text-dark fs-6">
                                                        @e.Amount.ToString("C")
                                                    </span>

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }

                                <div class="border-top pt-3">

                                    <div class="d-flex justify-content-end gap-2">

                                        <button @onclick="() => PromptRejection(log.Id)"
                                                class="btn btn-outline-danger">

                                            Afvis

                                        </button>

                                        <button @onclick="() => HandleApprove(log.Id)"
                                                class="btn btn-success">

                                            Godkend

                                        </button>

                                    </div>

                                </div>

                                @if (activeRejectionLogId == log.Id)
                                {
                                    <div class="alert alert-danger mt-4 mb-0">

                                        <label class="form-label fw-semibold">
                                            Årsag til afvisning
                                        </label>

                                        <input type="text"
                                               @bind="rejectionReason"
                                               class="form-control mb-3"
                                               placeholder="Indtast begrundelse..." />

                                        <div class="d-flex justify-content-end gap-2">

                                            <button @onclick="CancelRejection"
                                                    class="btn btn-outline-secondary btn-sm">

                                                Annuller

                                            </button>

                                            <button @onclick="SubmitRejection"
                                                    class="btn btn-danger btn-sm">

                                                Bekræft Afvisning

                                            </button>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-4">

                    @errorMessage

                </div>
            }

        </div>

    </div>

</div>

@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private IEnumerable<WorkLogDto>? pendingLogs;

    private Guid companyAccountId;
    private Guid? activeRejectionLogId;
    private string rejectionReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var guid = await authService.GetUserIdAsync();
        companyAccountId = Guid.Parse(guid);
        await LoadPendingLogs();
    }

    private async Task LoadPendingLogs()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            pendingLogs = await RegistrationService.GetPendingWorkLogs(companyAccountId, CancellationToken.None);
        }
        catch (Exception)
        {
            errorMessage = "Fejl under hentning af afventende arbejdssedler.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleApprove(Guid logId)
    {
        var result = await RegistrationService.ApproveWorkLog(companyAccountId, logId, CancellationToken.None);
        if (result.Success) await LoadPendingLogs();
        else errorMessage = result.Message;
    }

    private void PromptRejection(Guid logId)
    {
        activeRejectionLogId = logId;
        rejectionReason = string.Empty;
    }

    private void CancelRejection()
    {
        activeRejectionLogId = null;
        rejectionReason = string.Empty;
    }

    private async Task SubmitRejection()
    {
        if (activeRejectionLogId == null || string.IsNullOrWhiteSpace(rejectionReason)) return;

        var result = await RegistrationService.RejectWorkLog(companyAccountId, activeRejectionLogId.Value, rejectionReason, CancellationToken.None);
        if (result.Success)
        {
            CancelRejection();
            await LoadPendingLogs();
        }
        else
        {
            errorMessage = result.Message;
        }
    }
}