@page "/company/pending-approvals"
@inject RegistrationService RegistrationService
@inject IAuthService authService
@using UI.Services.Registration
@using UI.Services.Auth
@using Shared.Item.Registrations.DTOs
@using Shared.Item.Registrations.Commands
@using Shared.Item.Registrations.Commands.Time
@using Shared.Item.Registrations.Commands.Expenses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-xl-10">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        Afventende Godkendelser
                    </h2>

                    <p class="text-muted mb-0">
                        Gennemgå og godkend medarbejdernes tidsregistreringer.
                    </p>
                </div>

                <button @onclick="LoadPendingLogs"
                        class="btn btn-outline-secondary">

                    Opdater Liste

                </button>

            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>

                </div>
            }
            else if (pendingLogs == null || !pendingLogs.Any())
            {
                <div class="card border-0 shadow-sm">

                    <div class="card-body text-center py-5">

                        <h5 class="text-muted mb-0">
                            Der er i øjeblikket ingen tidsregistreringer, der venter på godkendelse.
                        </h5>

                    </div>

                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-4">

                    @foreach (var log in pendingLogs)
                    {
                        <div class="card border-0 shadow-sm">

                            <div class="card-header bg-light">

                                <div class="row g-3 align-items-center">

                                    <div class="col-md-6">

                                        <div class="small text-uppercase text-muted fw-bold">
                                            Medarbejder
                                        </div>

                                        <div class="fw-semibold">
                                            @log.EmployeeName
                                        </div>
                                    </div>

                                    <div class="col-md-6 text-md-end">

                                        <div class="small text-uppercase text-muted fw-bold">
                                            Dato Oprettet
                                        </div>

                                        <div>
                                            @log.ClockInTime.ToString("dd-MM-yyyy HH:mm")
                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="card-body">
                                <h6 class="fw-bold mb-3">
                                    ⏱ Tidsregistreringer
                                </h6>

                                <div class="list-group mb-4">

                                    @foreach (var t in log.TimeRegistrations)
                                    {
                                        <button type="button"
                                                class="list-group-item list-group-item-action"
                                                @onclick="() => OpenTimeRegistration(t)">

                                            <div class="d-flex justify-content-between align-items-center">

                                                <div>

                                                    <div class="fw-semibold">
                                                        @t.ProjectName
                                                    </div>

                                                    <div class="small text-muted">
                                                        @t.ProjectActivityName
                                                    </div>

                                                </div>

                                                <div class="text-end">

                                                    @if (!string.IsNullOrWhiteSpace(t.Description))
                                                    {
                                                        <div class="small text-muted">
                                                            @t.Description
                                                        </div>
                                                    }

                                                    <span class="badge bg-primary">
                                                        Vis detaljer
                                                    </span>

                                                </div>

                                            </div>

                                        </button>
                                    }

                                </div>

                                @if (log.ExpenseRegistrations?.Any() == true)
                                {
                                    <h6 class="fw-bold mb-3">
                                        💳 Udlæg & Udgifter
                                    </h6>

                                    <div class="list-group mb-4">

                                        @foreach (var e in log.ExpenseRegistrations)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action"
                                                    @onclick="() => OpenExpenseRegistration(e)">

                                                <div class="d-flex justify-content-between align-items-center">

                                                    <div>

                                                        <div class="fw-semibold">
                                                            @e.ExpenseName
                                                        </div>

                                                        <div class="small text-muted">
                                                            @e.Description
                                                        </div>

                                                    </div>

                                                    <div class="text-end">

                                                        <div class="fw-bold text-success">
                                                            @e.Amount.ToString("C")
                                                        </div>

                                                        <span class="badge bg-warning text-dark">
                                                            Vis detaljer
                                                        </span>

                                                    </div>

                                                </div>

                                            </button>
                                        }

                                    </div>
                                }

                                <div class="border-top pt-3">

                                    <div class="d-flex justify-content-end gap-2">

                                        <button @onclick="() => PromptRejection(log.Id)"
                                                class="btn btn-outline-danger">

                                            Afvis

                                        </button>

                                        <button @onclick="() => HandleApprove(log.Id)"
                                                class="btn btn-success">

                                            Godkend

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-4">

                    @errorMessage

                </div>
            }

        </div>

    </div>

</div>

@if (showTimeDetailsModal && selectedTimeRegistration != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Registreringsdetaljer
                    </h5>

                    <button class="btn-close"
                            @onclick="() => showTimeDetailsModal = false">
                    </button>

                </div>

                <div class="modal-body">

                    <dl class="row">

                        <dt class="col-sm-4">Projekt</dt>
                        <dd class="col-sm-8">@selectedTimeRegistration.ProjectName</dd>

                        <dt class="col-sm-4">Aktivitet</dt>
                        <dd class="col-sm-8">@selectedTimeRegistration.ProjectActivityName</dd>

                        <dt class="col-sm-4">Beskrivelse</dt>
                        <dd class="col-sm-8">@selectedTimeRegistration.Description</dd>

                    </dl>

                    <hr />

                    <h6>Intervaller</h6>

                    <div class="list-group">

                        @foreach (var interval in selectedTimeRegistration.Intervals)
                        {
                            <div class="list-group-item">

                                <div class="d-flex justify-content-between">

                                    <div>
                                        @interval.StartTime.ToString("dd-MM-yyyy HH:mm")
                                        →
                                        @interval.EndTime?.ToString("dd-MM-yyyy HH:mm")
                                    </div>

                                    <div>

                                        @if (interval.IsBreak)
                                        {
                                            <span class="badge bg-secondary">
                                                Pause
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Arbejde
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>
}
@if (showExpenseDetailsModal && selectedExpenseRegistration != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Udgiftsdetaljer
                    </h5>

                    <button class="btn-close"
                            @onclick="() => showExpenseDetailsModal = false">
                    </button>

                </div>

                <div class="modal-body">

                    <dl class="row">

                        <dt class="col-sm-4">Udgift</dt>
                        <dd class="col-sm-8">@selectedExpenseRegistration.ExpenseName</dd>

                        <dt class="col-sm-4">Beløb</dt>
                        <dd class="col-sm-8">
                            @selectedExpenseRegistration.Amount.ToString("C")
                        </dd>

                        <dt class="col-sm-4">Dato</dt>
                        <dd class="col-sm-8">
                            @selectedExpenseRegistration.Date.ToShortDateString()
                        </dd>

                        <dt class="col-sm-4">Beskrivelse</dt>
                        <dd class="col-sm-8">
                            @selectedExpenseRegistration.Description
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

    </div>
}
@if (activeRejectionLogId.HasValue)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg">

                <div class="modal-header">

                    <h5 class="modal-title text-danger">
                        Afvis Registrering
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CancelRejection">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="alert alert-warning mb-3">

                        Du er ved at afvise denne tidsregistrering.
                        Angiv venligst en begrundelse.

                    </div>

                    <label class="form-label fw-semibold">
                        Årsag til afvisning
                    </label>

                    <textarea @bind="rejectionReason"
                              class="form-control"
                              rows="4"
                              placeholder="Indtast begrundelse...">
                    </textarea>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-outline-secondary"
                            @onclick="CancelRejection">

                        Annuller

                    </button>

                    <button class="btn btn-danger"
                            @onclick="SubmitRejection">

                        Bekræft Afvisning

                    </button>

                </div>

            </div>

        </div>

    </div>
}
@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private IEnumerable<WorkLogDto>? pendingLogs;

    private Guid companyAccountId;
    private Guid? activeRejectionLogId;
    private string rejectionReason = string.Empty;
    private TimeRegistrationDto? selectedTimeRegistration;
    private ExpenseRegistrationDto? selectedExpenseRegistration;

    private bool showTimeDetailsModal;
    private bool showExpenseDetailsModal;

    private void PromptRejection(Guid logId)
    {
        activeRejectionLogId = logId;
        rejectionReason = string.Empty;
    }

    private void CancelRejection()
    {
        activeRejectionLogId = null;
        rejectionReason = string.Empty;
    }

    private void OpenTimeRegistration(TimeRegistrationDto registration)
    {
        selectedTimeRegistration = registration;
        showTimeDetailsModal = true;
    }

    private void OpenExpenseRegistration(ExpenseRegistrationDto registration)
    {
        selectedExpenseRegistration = registration;
        showExpenseDetailsModal = true;
    }
    protected override async Task OnInitializedAsync()
    {
        var guid = await authService.GetUserIdAsync();
        companyAccountId = Guid.Parse(guid);
        await LoadPendingLogs();
    }

    private async Task LoadPendingLogs()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            pendingLogs = await RegistrationService.GetPendingWorkLogs(companyAccountId, CancellationToken.None);
        }
        catch (Exception)
        {
            errorMessage = "Fejl under hentning af afventende arbejdssedler.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleApprove(Guid logId)
    {
        var result = await RegistrationService.ApproveWorkLog(companyAccountId, logId, CancellationToken.None);
        if (result.Success) await LoadPendingLogs();
        else errorMessage = result.Message;
    }


    private async Task SubmitRejection()
    {
        if (activeRejectionLogId == null || string.IsNullOrWhiteSpace(rejectionReason)) return;

        var result = await RegistrationService.RejectWorkLog(companyAccountId, activeRejectionLogId.Value, rejectionReason, CancellationToken.None);
        if (result.Success)
        {
            CancelRejection();
            await LoadPendingLogs();
        }
        else
        {
            errorMessage = result.Message;
        }
    }
}