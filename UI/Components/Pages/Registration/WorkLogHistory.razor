@page "/worklog/history"
@using Shared.Item.Registrations.DTOs
@using UI.Services.Registration
@inject RegistrationService RegistrationService
@inject IAuthService authService
@using UI.Services.Registration
@using Shared.Item.Registrations.DTOs
@using Shared.Item.Registrations.Commands
@using Shared.Item.Registrations.Commands.Time
@using Shared.Item.ProjectActivity
@using Shared.Item.Registrations.Commands.Expenses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using UI.Services.Auth
@using Shared.Model
@attribute [Authorize]

<div class="container mx-auto p-4 max-w-3xl">
    <h2 class="text-2xl font-bold mb-4">Mine Arbejdsdage</h2>

    @if (isLoading)
    {
        <div class="flex justify-center my-8">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (!WorkLogs.Any())
    {
        <div class="bg-white rounded-xl shadow p-6 border border-slate-100 text-center text-slate-500">
            Ingen arbejdsposter fundet.
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var log in WorkLogs.OrderByDescending(w => w.ClockInTime))
            {
                <div class="bg-white rounded-xl shadow p-4 border border-slate-100">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-center space-x-3">
                                <h3 class="font-semibold text-lg">Dag: @log.ClockInTime.ToShortDateString()</h3>
                                <span class="px-2 py-0.5 text-xs rounded-full bg-slate-100 text-slate-700">Status: @log.Status</span>
                            </div>
                            <div class="text-sm text-slate-500">Start: @log.ClockInTime.ToShortTimeString() @if(log.ClockOutTime.HasValue){<span>- Slut: @log.ClockOutTime?.ToShortTimeString()</span>}</div>
                            @if(!string.IsNullOrEmpty(log.RejectionReason))
                            {
                                <div class="mt-2 text-sm text-rose-600">Afvist: @log.RejectionReason</div>
                            }
                        </div>
                        <div class="flex items-center space-x-2">
                            @if (log.Status == "Draft")
                            {
                                <button @onclick="() => HandleSubmit(log.Id)" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded">Send til godkendelse</button>
                            }
                            <button @onclick="() => ToggleDetails(log.Id)" class="px-3 py-1 border rounded text-sm">@((expandedLogId == log.Id) ? "Skjul" : "Vis")</button>
                        </div>
                    </div>

                    @if (expandedLogId == log.Id)
                    {
                        <div class="mt-4 border-t pt-3 space-y-3">
                            <h4 class="font-medium text-slate-700">Tidsregistreringer</h4>
                            @if (!log.TimeRegistrations.Any())
                            {
                                <div class="text-sm text-slate-400 italic">Ingen tidsregistreringer.</div>
                            }
                            else
                            {
                                <div class="space-y-2">
                                    @foreach (var t in log.TimeRegistrations)
                                    {
                                        <div class="p-2 rounded border bg-slate-50">
                                            <div class="flex justify-between items-center">
                                                <div>
                                                    <div class="font-semibold">@t.ProjectName</div>
                                                    <div class="text-xs text-slate-500">@t.ProjectActivityName</div>
                                                </div>
                                                <div class="text-sm text-slate-600">
                                                    @foreach(var i in t.Intervals)
                                                    {
                                                        <div>@(i.IsBreak ? "Pause" : "Arbejde"): @i.StartTime.ToShortTimeString() - @i.EndTime?.ToShortTimeString()</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <h4 class="font-medium text-slate-700 pt-2">Udgifter</h4>
                            @if (!log.ExpenseRegistrations.Any())
                            {
                                <div class="text-sm text-slate-400 italic">Ingen udgifter registreret.</div>
                            }
                            else
                            {
                                <div class="space-y-2">
                                    @foreach (var e in log.ExpenseRegistrations)
                                    {
                                        <div class="p-2 rounded border bg-slate-50 flex justify-between items-center">
                                            <div>
                                                <div class="font-semibold">@e.ExpenseName (@e.Amount.ToString("C2"))</div>
                                                <div class="text-xs text-slate-500">@e.Description</div>
                                            </div>
                                            <div class="text-xs text-slate-400">@e.Date.ToShortDateString()</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-sm">@errorMessage</div>
    }
</div>

@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private List<WorkLogDto> WorkLogs = new();
    private Guid userId;
    private Guid expandedLogId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var guid = await authService.GetUserIdAsync();
            userId = Guid.Parse(guid);
            await LoadHistory();
        }
        catch (Exception ex)
        {
            errorMessage = "Kunne ikke hente data.";
        }
        finally { isLoading = false; }
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var result = await RegistrationService.GetWorkLogHistory(userId, CancellationToken.None);
            WorkLogs = result?.ToList() ?? new();
        }
        catch (Exception)
        {
            errorMessage = "Kunne ikke hente arbejdsposter.";
        }
        finally { isLoading = false; }
    }

    private async Task HandleSubmit(Guid workLogId)
    {
        errorMessage = string.Empty;
        try
        {
            var res = await RegistrationService.SubmitWorkLogForApproval(userId, workLogId, CancellationToken.None);
            if (res.Success)
            {
                await LoadHistory();
            }
            else
            {
                errorMessage = res.Message;
            }
        }
        catch (Exception)
        {
            errorMessage = "Kunne ikke sende til godkendelse.";
        }
    }

    private void ToggleDetails(Guid id)
    {
        expandedLogId = expandedLogId == id ? Guid.Empty : id;
    }
}
