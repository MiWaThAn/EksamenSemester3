@page "/worklog/history"
@using Shared.Item.Registrations.DTOs
@using UI.Services.Registration
@inject RegistrationService RegistrationService
@inject IAuthService authService
@using UI.Services.Registration
@using Shared.Item.Registrations.DTOs
@using Shared.Item.Registrations.Commands
@using Shared.Item.Registrations.Commands.Time
@using Shared.Item.ProjectActivity
@using Shared.Item.Registrations.Commands.Expenses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using UI.Services.Auth
@using Shared.Model
@attribute [Authorize]

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-xl-10">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        Mine Arbejdsdage
                    </h2>

                    <p class="text-muted mb-0">
                        Oversigt over dine arbejdsdage, timer og udgifter.
                    </p>
                </div>

            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>

                </div>
            }
            else if (!WorkLogs.Any())
            {
                <div class="card border-0 shadow-sm">

                    <div class="card-body text-center py-5">

                        <h5 class="text-muted mb-0">
                            Ingen arbejdsposter fundet.
                        </h5>

                    </div>

                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">

                    @foreach (var log in WorkLogs.OrderByDescending(w => w.ClockInTime))
                    {
                        <div class="card border-0 shadow-sm">

                            <div class="card-body">

                                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">

                                    <div>

                                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">

                                            <h5 class="mb-0">
                                                📅 @log.ClockInTime.ToShortDateString()
                                            </h5>

                                            @if (log.Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    @log.Status
                                                </span>
                                            }
                                            else if (log.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    @log.Status
                                                </span>
                                            }
                                            else if (log.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    @log.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    @log.Status
                                                </span>
                                            }

                                        </div>

                                        <div class="text-muted small">

                                            Start:
                                            @log.ClockInTime.ToShortTimeString()

                                            @if (log.ClockOutTime.HasValue)
                                            {
                                                <span>
                                                    · Slut:
                                                    @log.ClockOutTime.Value.ToShortTimeString()
                                                </span>
                                            }

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(log.RejectionReason))
                                        {
                                            <div class="alert alert-danger mt-3 mb-0 py-2">

                                                <strong>Afvist:</strong>
                                                @log.RejectionReason

                                            </div>
                                        }

                                    </div>

                                    <div class="d-flex flex-wrap gap-2 align-items-start">

                                        @if (log.Status == "Draft")
                                        {
                                            <button @onclick="() => HandleSubmit(log.Id)"
                                                    class="btn btn-success">

                                                Send til godkendelse

                                            </button>
                                        }

                                        <button @onclick="() => ToggleDetails(log.Id)"
                                                class="btn btn-outline-primary">

                                            @(expandedLogId == log.Id
                                                ? "Skjul detaljer"
                                                : "Vis detaljer")

                                        </button>

                                    </div>

                                </div>

                                @if (expandedLogId == log.Id)
                                {
                                    <hr />

                                    <div class="row g-4">

                                        <div class="col-lg-7">

                                            <h6 class="fw-bold mb-3">
                                                ⏱ Tidsregistreringer
                                            </h6>

                                            @if (!log.TimeRegistrations.Any())
                                            {
                                                <div class="alert alert-light border">
                                                    Ingen tidsregistreringer.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var t in log.TimeRegistrations)
                                                {
                                                    <div class="card mb-3">

                                                        <div class="card-body">

                                                            <div class="d-flex justify-content-between flex-wrap gap-2">

                                                                <div>

                                                                    <div class="fw-semibold">
                                                                        @t.ProjectName
                                                                    </div>

                                                                    <div class="text-muted small">
                                                                        @t.ProjectActivityName
                                                                    </div>

                                                                </div>

                                                            </div>

                                                            <div class="mt-3">

                                                                @foreach (var i in t.Intervals)
                                                                {
                                                                    <div class="d-flex justify-content-between border rounded p-2 mb-2">

                                                                        <span>
                                                                            @(i.IsBreak ? "⏸ Pause" : "▶ Arbejde")
                                                                        </span>

                                                                        <span class="text-muted">
                                                                            @i.StartTime.ToShortTimeString()
                                                                            -
                                                                            @i.EndTime?.ToShortTimeString()
                                                                        </span>

                                                                    </div>
                                                                }

                                                            </div>

                                                        </div>

                                                    </div>
                                                }
                                            }

                                        </div>

                                        <div class="col-lg-5">

                                            <h6 class="fw-bold mb-3">
                                                💳 Udgifter
                                            </h6>

                                            @if (!log.ExpenseRegistrations.Any())
                                            {
                                                <div class="alert alert-light border">
                                                    Ingen udgifter registreret.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="list-group">

                                                    @foreach (var e in log.ExpenseRegistrations)
                                                    {
                                                        <div class="list-group-item">

                                                            <div class="d-flex justify-content-between align-items-start">

                                                                <div>

                                                                    <div class="fw-semibold">
                                                                        @e.ExpenseName
                                                                    </div>

                                                                    <div class="small text-muted">
                                                                        @e.Description
                                                                    </div>

                                                                </div>

                                                                <div class="text-end">

                                                                    <div class="fw-bold text-success">
                                                                        @e.Amount.ToString("C2")
                                                                    </div>

                                                                    <div class="small text-muted">
                                                                        @e.Date.ToShortDateString()
                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </div>
                                                    }

                                                </div>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-4">

                    @errorMessage

                </div>
            }

        </div>

    </div>

</div>
@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private List<WorkLogDto> WorkLogs = new();
    private Guid userId;
    private Guid expandedLogId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var guid = await authService.GetUserIdAsync();
            userId = Guid.Parse(guid);
            await LoadHistory();
        }
        catch (Exception ex)
        {
            errorMessage = "Kunne ikke hente data.";
        }
        finally { isLoading = false; }
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var result = await RegistrationService.GetWorkLogHistory(userId, CancellationToken.None);
            WorkLogs = result?.ToList() ?? new();
        }
        catch (Exception)
        {
            errorMessage = "Kunne ikke hente arbejdsposter.";
        }
        finally { isLoading = false; }
    }

    private async Task HandleSubmit(Guid workLogId)
    {
        errorMessage = string.Empty;
        try
        {
            var res = await RegistrationService.SubmitWorkLogForApproval(userId, workLogId, CancellationToken.None);
            if (res.Success)
            {
                await LoadHistory();
            }
            else
            {
                errorMessage = res.Message;
            }
        }
        catch (Exception)
        {
            errorMessage = "Kunne ikke sende til godkendelse.";
        }
    }

    private void ToggleDetails(Guid id)
    {
        expandedLogId = expandedLogId == id ? Guid.Empty : id;
    }
}
