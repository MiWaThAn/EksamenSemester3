﻿@using UI.Services.Auth
@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject UI.Services.Theme.ThemeService ThemeService
@implements IDisposable
<div class="page" style="background-color: @ThemeService.BackgroundColor; transition: background-color 0.4s ease;">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
        var currentUri = Nav.ToBaseRelativePath(Nav.Uri).ToLower();
        if (currentUri.StartsWith("auth/"))
        {
            return;
        }

        var status = await AuthService.GetRequiredLoginState();

        if (status == AuthStateStatus.NeedsFullLogin)
        {
            await AuthService.Logout();

            Nav.NavigateTo("/auth/login");
        }
        else if (status == AuthStateStatus.NeedsPinLogin)
        {
            Nav.NavigateTo("/auth/pin-login");
        }
        else
        {
            await AuthService.AutoLogin();
        }
    }
    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}